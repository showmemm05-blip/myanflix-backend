generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  CONTENT_UPLOADER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  /// The owner deleted their own account (DELETE /users/me, H-16): personal
  /// data anonymised, sessions revoked, money records kept. Terminal — no
  /// status route can move an account out of it, and no sign-in path
  /// accepts it.
  CLOSED
}

/// What an OTP code was requested for. Every verify path accepts only its
/// own: LOGIN for POST /auth/otp/verify, PASSWORD_RESET for POST
/// /auth/password/reset (both requested through POST /auth/otp/request
/// `purpose`), and WITHDRAWAL_CODE_RESET for the signed-in "forgot
/// withdrawal code" flow (requested and verified only through
/// /users/me/withdrawal-code/reset/*, never through /auth/otp/request).
enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  WITHDRAWAL_CODE_RESET
}

/// Where one outgoing SMS is in the phone-gateway pipeline (SmsMessage).
/// QUEUED -> LEASED (the gateway phone took it) -> SENT (the SIM accepted
/// it) -> DELIVERED / DELIVERY_FAILED (the carrier's delivery report), or
/// LEASED -> FAILED (the phone could not send it). The sweeper moves a
/// QUEUED row past its expiry to EXPIRED and a LEASED row whose lease ran
/// out with no result to UNKNOWN (the phone may or may not have sent it —
/// nothing is ever re-queued, so a code is sent at most once). A QUEUED row
/// becomes CANCELLED when a newer code for the same phone and purpose
/// replaces the one it carries, or when that phone's account is closed:
/// the phone never gets it.
enum SmsMessageStatus {
  QUEUED
  LEASED
  SENT
  DELIVERED
  FAILED
  DELIVERY_FAILED
  EXPIRED
  UNKNOWN
  CANCELLED
}

enum MovieStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
  /// The bulk pre-transcoded upload flow's own lifecycle — a movie starts
  /// here the instant its folder is picked, moves to READY_TO_PUBLISH once
  /// every file is uploaded and validated (or FAILED if it isn't), and only
  /// reaches PUBLISHED via an explicit admin action. Never visible to users.
  UPLOADING
  FAILED
  READY_TO_PUBLISH
}

/// Show-level publish lifecycle — independent of the per-episode
/// MovieStatus. A series is created DRAFT, made visible to users by an
/// explicit publish (PUBLISHED), and can be hidden again (UNPUBLISHED)
/// while staying fully manageable in the admin.
enum SeriesStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum UploadStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SubtitleFormat {
  SRT
  VTT
  ASS
}

/// How a book's content came to exist — the two are deliberately NOT the
/// same product with a flag: an EDITOR book is chapters of rich text written
/// in the admin dashboard, a PDF book is an uploaded original converted
/// page-by-page into WebP images. Readers, admin actions and storage layout
/// all branch on this.
enum BookType {
  EDITOR
  PDF
}

/// One lifecycle for both book types. EDITOR books only ever move
/// DRAFT <-> PUBLISHED. PDF books walk UPLOADING -> PROCESSING ->
/// READY -> PUBLISHED (or FAILED, retryable back into PROCESSING);
/// unpublishing returns them to READY. Users only ever see PUBLISHED.
enum BookStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  PUBLISHED
  FAILED
}

/// One CHAPTER's own lifecycle, distinct from the edition's publish state.
///
/// A written chapter is READY the moment it has text. A PDF chapter carries
/// its own file, so it walks UPLOADING -> PROCESSING -> READY (or FAILED,
/// retryable) exactly as a whole edition used to before chapters existed.
/// PUBLISHED is deliberately absent: publishing is an edition-wide act, and a
/// half-published book is not a thing.
enum ChapterStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  SUBSCRIPTION
  WITHDRAWAL
  /// Admin-initiated wallet correction (see WalletAdjustment) — credit adds
  /// to the balance, debit removes from it.
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  /// A lottery ticket purchase (one row per purchase, the whole total) and
  /// a lottery prize paid into the wallet (phase 3). See LotteryPurchase.
  LOTTERY_PURCHASE
  LOTTERY_PRIZE
}

/// Ledger entry type for a single PaymentAccount's own audit trail — distinct
/// from TransactionType (the user-wallet ledger) to avoid an import name
/// collision. `amount` on PaymentAccountTransaction is always a positive
/// magnitude; credit vs debit is derived from this type via a fixed map in
/// PaymentAccountLedgerService, never a separately stored sign/direction.
enum PaymentAccountTransactionType {
  OPENING_BALANCE
  MANUAL_CREDIT
  MANUAL_DEBIT
  DEPOSIT_IN
  WITHDRAWAL_OUT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

/// FREE content is streamable by anyone; SUBSCRIPTION content requires an
/// active UserSubscription (any plan — plans differ only in price/name, not
/// in what they unlock).
enum AccessType {
  FREE
  SUBSCRIPTION
}

/// MPAA-style age rating for a movie. Stored without punctuation (PG13,
/// NC17) so the enum member is a valid identifier everywhere; clients render
/// the display form (PG-13, NC-17). Nullable on Movie: NULL means "unrated /
/// not yet set", and the catalog's age-rating filter auto-hides until at
/// least one movie carries a value.
enum AgeRating {
  G
  PG
  PG13
  R
  NC17
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Declared in this order deliberately — Postgres native enums sort by
/// declaration order, not alphabetically, so `ORDER BY status ASC` puts
/// PENDING rows first without any raw SQL or extra sort key.
enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The BANK side of a deposit/withdrawal — orthogonal to DepositStatus /
/// WithdrawalStatus, which stay the MONEY state. UNVERIFIED = no bank
/// notification applied yet; MATCHED = every exact check passed and no
/// reason; PENDING_REVIEW = a soft reason (twin reference, ambiguity, gap,
/// velocity); SUSPICIOUS = a hard mismatch (amount/code/impossible timing/
/// shared across users). "No bank transaction after 24 h" is deliberately
/// NOT a member: it is derived at read time from status + bankCheckedAt +
/// createdAt, so nothing ever has to sweep the table to set it.
enum BankMatchStatus {
  UNVERIFIED
  MATCHED
  PENDING_REVIEW
  SUSPICIOUS
}

/// Deterministic bucket of the summed reason weights (see
/// bank-events/risk-rules.ts). Null = not scored yet.
enum BankRiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// Which way the money went, as the phone's notification said it:
/// "You received …" or "You sent …".
enum BankTransactionDirection {
  RECEIVED
  SENT
}

/// UNMATCHED = stored, no row claimed it; MATCHED = linked to exactly one
/// deposit/withdrawal; AMBIGUOUS = ≥ 2 candidates fit and nobody guessed.
/// "Unclaimed" is NOT a member: it is derived at read time (UNMATCHED and
/// occurredAt older than 48 h) — nothing ever sweeps.
enum BankTransactionState {
  UNMATCHED
  MATCHED
  AMBIGUOUS
}

enum NotificationType {
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  BALANCE_ADJUSTED
}

enum WalletAdjustmentDirection {
  CREDIT
  DEBIT
}

/// Which client an action came from. Resolved server-side from the
/// `X-Client-Platform` request header (or the socket handshake's `platform`),
/// falling back to a user-agent sniff and then to UNKNOWN — never from a
/// value a client can pass as ordinary payload. UNKNOWN is a real, expected
/// value (curl, an older client build, a background job), not an error state.
enum ClientPlatform {
  WEB
  MOBILE
  UNKNOWN
}

/// Moderation state of a Comment. HIDDEN rows stay in the table (the audit
/// trail and the tracking counts need them) but are never served to users.
enum CommentStatus {
  VISIBLE
  HIDDEN
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  CONTENT
  PAYMENT
  OTHER
}

/// Declared in triage order deliberately — Postgres native enums sort by
/// declaration order, so `ORDER BY status ASC` puts NEW rows first without
/// any raw SQL or extra sort key (same trick as WithdrawalStatus).
enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// Which admin area a staff action belongs to — the coarse filter on the
/// audit log screen. Assigned per action by the catalogue in
/// src/audit/audit-actions.ts, never chosen by the caller.
enum AuditCategory {
  CONTENT
  USERS
  FINANCE
  STAFF
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(uuid())
  username    String     @unique
  password    String
  /// Set for phone+OTP accounts. Nullable so username/password accounts are unaffected.
  phone       String?    @unique
  /// E-mail from "Continue with Google" — verified by Google, stored
  /// lower-cased. NULL for every phone/username account; never user-editable
  /// and never exposed through UserResponseDto (nothing widens).
  email       String?    @unique
  /// Google's stable account id (the ID token's `sub` claim). Set when an
  /// account is created by, or linked to, Google sign-in; NULL otherwise.
  googleId    String?    @unique
  /// Free-text name the user picks for themselves and can edit from their
  /// profile. Purely cosmetic: `username` and `phone` remain the login
  /// identities and are never edited through the profile screen. NULL means
  /// "not set" — clients fall back to username/phone for display.
  displayName String?
  /// MinIO object KEY for the profile picture
  /// (images/user/<userId>/<epochMs>.<jpg|png|webp>) — never an absolute URL.
  /// The epoch-ms filename is the version stamp, so a replaced picture can
  /// never collide with the cache server's entry for the old one, and the
  /// per-user folder makes every avatar this user ever uploaded reachable in
  /// one prefix delete (UsersService.deleteAvatarObjects).
  avatar      String?
  role        Role       @default(USER)
  /// Granular RBAC assignment (see AppRole). NULL falls back to the seeded
  /// system AppRole whose `key` equals `role`, so pre-RBAC rows keep working.
  appRoleId   String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLoginAt DateTime?

  /// Presence, refreshed (throttled) from any authenticated request on any
  /// client — distinct from `lastLoginAt`, which only moves on a fresh
  /// sign-in and so says nothing about whether the account is active now.
  lastSeenAt        DateTime?
  /// Last observed client IP, denormalised from UserSession so the admin's
  /// Phone/IP table is one query. Always masked server-side unless the
  /// caller holds TRACKING.PII_VIEW.
  lastIpAddress     String?
  /// Last observed client platform, denormalised from UserSession for the
  /// same reason as `lastIpAddress`.
  lastPlatform      ClientPlatform?
  /// When every session of this account was last revoked (password change or
  /// reset, suspension, ban, role change, account deletion — H-21). Access
  /// tokens issued in an earlier second are refused by JwtStrategy and the
  /// realtime handshake, so a revoke takes effect at once rather than when
  /// the 15-minute access token expires. NULL = never revoked.
  sessionsRevokedAt DateTime?

  /// The 6-digit withdrawal code every POST /withdrawals must carry, as a
  /// bcrypt hash (same cost as passwords) — never the code itself, and never
  /// returned by any route or written to any log. NULL = the account has no
  /// code yet: its next withdrawal first creates one (WithdrawalCodeService).
  withdrawalCodeHash        String?
  /// When the current code was created, changed or reset. Also the version a
  /// "forgot code" reset step token is bound to, so one SMS check sets at
  /// most one new code.
  withdrawalCodeSetAt       DateTime?
  /// Wrong codes in a row since the last right one (or since the last lock
  /// ran out). The 5th locks the code for 15 minutes; a right code resets it.
  withdrawalCodeFailedCount Int       @default(0)
  /// Set by the 5th wrong code in a row: until then every code — even the
  /// right one — is refused. A lock in the past means "lock over, counter
  /// starts again from 0". The SMS reset clears it.
  withdrawalCodeLockedUntil DateTime?

  wallet                              Wallet?
  purchases                           Purchase[]
  seriesPurchases                     SeriesPurchase[]
  subscriptions                       UserSubscription[]
  transactions                        Transaction[]
  watchHistory                        WatchHistory[]
  refreshTokens                       RefreshToken[]
  deposits                            Deposit[]
  depositApprovals                    Deposit[]                   @relation("DepositApprovals")
  notifications                       Notification[]
  paymentAccountsCreated              PaymentAccount[]            @relation("PaymentAccountCreatedBy")
  paymentAccountsUpdated              PaymentAccount[]            @relation("PaymentAccountUpdatedBy")
  withdrawals                         Withdrawal[]
  withdrawalApprovals                 Withdrawal[]                @relation("WithdrawalApprovals")
  financeSettingsUpdates              FinanceSettings[]           @relation("FinanceSettingsUpdatedBy")
  peakUserStatsUpdates                PeakUserStats[]             @relation("PeakUserStatsUpdatedBy")
  paymentAccountTransactionsPerformed PaymentAccountTransaction[] @relation("PaymentAccountTransactionPerformedBy")
  walletAdjustments                   WalletAdjustment[]          @relation("WalletAdjustmentUser")
  walletAdjustmentsPerformed          WalletAdjustment[]          @relation("WalletAdjustmentPerformedBy")
  appRole                             AppRole?                    @relation("UserAppRole", fields: [appRoleId], references: [id], onDelete: SetNull)
  comments                            Comment[]
  commentPostEvents                   CommentPostEvent[]
  feedbacks                           Feedback[]                  @relation("FeedbackAuthor")
  handledFeedbacks                    Feedback[]                  @relation("FeedbackHandledBy")
  searchQueries                       SearchQuery[]
  watchActivities                     WatchActivity[]
  sessions                            UserSession[]
  bookReadingProgress                 BookReadingProgress[]
  auditLogs                           AuditLog[]
  homePromosCreated                   HomePromo[]                 @relation("HomePromoCreatedBy")
  homeSettingsUpdates                 HomeSettings[]              @relation("HomeSettingsUpdatedBy")
  lotterySettingsUpdates              LotterySettings[]           @relation("LotterySettingsUpdatedBy")
  lotteryDrawsCreated                 LotteryDraw[]               @relation("LotteryDrawCreatedBy")
  lotteryPurchases                    LotteryPurchase[]           @relation("LotteryPurchaseUser")
  lotteryTickets                      LotteryTicket[]             @relation("LotteryTicketUser")
  lotteryDrawsPublished               LotteryDraw[]               @relation("LotteryDrawPublishedBy")
  lotteryResultsEntered               LotteryResult[]             @relation("LotteryResultEnteredBy")
  lotteryPayouts                      LotteryPayout[]             @relation("LotteryPayoutUser")
  lotteryActivities                   LotteryActivity[]           @relation("LotteryActivityUser")
  lotteryClaims                       LotteryClaim[]              @relation("LotteryClaimUser")
  lotteryClaimsDecided                LotteryClaim[]              @relation("LotteryClaimDecidedBy")
  advertisementsCreated               Advertisement[]             @relation("AdvertisementCreatedBy")
  advertisementPlaybacks              AdvertisementPlayback[]     @relation("AdvertisementPlaybackUser")
  adSettingsUpdates                   AdSettings[]                @relation("AdSettingsUpdatedBy")

  @@index([appRoleId])
  /// Sign-up range counts on the analytics dashboard.
  @@index([createdAt])
  /// Admin subscribers list: role = USER, newest first.
  @@index([role, createdAt(sort: Desc)])
  @@map("users")
}

/// A database-driven RBAC role: a named bundle of `MODULE.ACTION` permissions
/// (see src/roles/permission-catalogue.ts) that staff accounts are assigned to.
///
/// The `Role` enum is NOT replaced by this — it stays the coarse "account
/// kind" axis (USER vs staff) that auth, the website and the mobile app read.
/// AppRole is the fine-grained authorization axis, editable at runtime from
/// the admin roles screen with no redeploy and no re-login.
model AppRole {
  id          String   @id @default(uuid())
  /// Stable identifier. The four seeded roles use the `Role` enum members
  /// verbatim so a user with a NULL appRoleId resolves through this column.
  key         String   @unique
  name        String
  description String?
  /// The four built-ins: never deletable, `key` immutable.
  isSystem    Boolean  @default(false)
  /// SUPER_ADMIN only: permissions are not editable either, and the resolver
  /// short-circuits it to every permission so it can never lock itself out.
  isProtected Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AppRolePermission[]
  users       User[]              @relation("UserAppRole")

  @@map("app_roles")
}

/// One granted permission string on one role. Stored as rows rather than a
/// string[] column so the unique constraint does the de-duplication and a
/// permission grant/revoke is a single row insert/delete.
model AppRolePermission {
  id         String   @id @default(uuid())
  roleId     String
  /// A `MODULE.ACTION` value from the catalogue. Kept as a plain String (not
  /// a Postgres enum) so adding a permission is a code change, not a migration.
  permission String
  createdAt  DateTime @default(now())

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("app_role_permissions")
}

/// Server-side record of issued refresh tokens so /auth/logout can revoke a
/// session instead of only relying on short-lived access tokens expiring.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A one-time code for phone+OTP signup/login. Not tied to a userId — the
/// phone number itself is the identity, since verifying it is what creates
/// or authenticates the account.
///
/// `codeHash` (M-1) is an HMAC-SHA256 of the 6 digits under a server secret
/// (OTP_CODE_PEPPER, or a key derived from JWT_SECRET) — see
/// src/otp/otp-code.hasher.ts. The plain code is never written here, so a
/// database read alone cannot reset a password or sign in. With
/// SMS_PROVIDER=log (the development default, see SmsService) the code is
/// read from the backend log; with phone-gateway the company phone sends
/// it (SmsMessage.body carries the text until it is sent).
///
/// `purpose` binds the code to the flow it was requested for: a sign-in code
/// never resets a password, and a reset code never signs anyone in.
///
/// Rows older than a day are swept by OtpService every night (a code lives
/// 5 minutes; the hourly request cap only looks back one hour).
model OtpCode {
  id           String     @id @default(uuid())
  phone        String
  codeHash     String
  purpose      OtpPurpose @default(LOGIN)
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  /// The SMS that carries this code, when SMS_PROVIDER=phone-gateway.
  smsMessage SmsMessage?

  @@index([phone])
  @@map("otp_codes")
}

/// One outgoing SMS for the company gateway phone (SMS_PROVIDER=
/// phone-gateway). SmsService queues it; the phone long-polls
/// GET /sms-gateway/device/jobs, which leases the oldest QUEUED row
/// atomically (FOR UPDATE SKIP LOCKED), sends it from its own SIM and
/// reports back through POST /sms-gateway/device/jobs/:id/result.
///
/// `otpCodeId` is UNIQUE so one code can never be queued twice. `body`
/// holds the code — never log it. `expiresAt` is the code's own expiry: a
/// row still QUEUED after it is swept to EXPIRED instead of being sent late.
/// The sweeper replaces `body` with "[redacted]" once the row is final and
/// an hour old; closing the account redacts `phone` and `body` at once.
model SmsMessage {
  id             String           @id @default(uuid()) @db.Uuid
  otpCodeId      String?          @unique
  otpCode        OtpCode?         @relation(fields: [otpCodeId], references: [id], onDelete: SetNull)
  phone          String
  body           String
  status         SmsMessageStatus @default(QUEUED)
  /// The gateway device that leased it (sms_gateway_devices.id, not a FK).
  deviceId       String?
  leasedAt       DateTime?
  /// min(leasedAt + 60 s, expiresAt); past it with no result -> UNKNOWN.
  leaseExpiresAt DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  /// When FAILED or DELIVERY_FAILED was reported.
  failedAt       DateTime?
  errorCode      String?
  errorMessage   String?
  expiresAt      DateTime
  /// When `body` (and, on account close, `phone`) was replaced with
  /// "[redacted]"; null while the row still holds them.
  redactedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([expiresAt])
  /// The daily-cap count and the staff status card read "rows created
  /// since UTC midnight".
  @@index([createdAt])
  /// The per-phone daily cap, the resend cancel and the account-close
  /// redaction all look rows up by phone.
  @@index([phone, createdAt])
  /// The sweeper's redaction pass: only rows still holding their body.
  @@index([createdAt], map: "sms_messages_unredacted_createdAt_idx", where: raw("\"redactedAt\" IS NULL"))
  @@map("sms_messages")
}

/// The company phone(s) running the SMS gateway app, keyed by the stable
/// uuid the app generates once (X-Device-Id). One row per device, upserted
/// by every heartbeat; a job poll refreshes lastSeenAt too. The gateway is
/// "online" while some device was seen within
/// SMS_GATEWAY_OFFLINE_AFTER_SECONDS.
model SmsGatewayDevice {
  id             String   @id
  lastSeenAt     DateTime
  appVersion     String
  /// Battery percentage, 0-100.
  battery        Int
  charging       Boolean
  /// Android's 0-4 signal bars; null when unknown.
  signalLevel    Int?
  networkType    String?
  simOperator    String?
  /// Results the phone has stored but not yet uploaded.
  pendingResults Int      @default(0)
  lastError      String?
  /// The phone's own verdict in its last heartbeat: false while it cannot
  /// send (no permission, no SIM, no service, ...). A device that says so
  /// counts as offline — codes are refused with the 503 and it is leased
  /// nothing. True when the app does not report it.
  canSend        Boolean  @default(true)
  /// Why canSend is false, in the app's own short words (<= 64 chars).
  notReadyReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sms_gateway_devices")
}

/// The ONE phone the shared SMS_GATEWAY_TOKEN is bound to (H-5 / H-7,
/// 2026-10-06). A single row (id 1). The first device uuid that presents
/// the right token is pinned here; every other uuid is refused with 401
/// and recorded as a rejection so the admin card can warn. A super admin
/// clears the pin (DELETE /sms-gateway/binding) after a phone reinstall;
/// the next device to present the token is then pinned.
model SmsGatewayBinding {
  id                   Int       @id @default(1)
  /// The pinned device uuid; null while nothing is pinned (fresh install,
  /// or right after a staff reset).
  deviceId             String?
  pinnedAt             DateTime?
  /// The last device that presented the right token under another uuid.
  lastRejectedDeviceId String?
  lastRejectedAt       DateTime?
  /// Refusals since the pin was set (cleared by a reset).
  rejectedCount        Int       @default(0)
  /// The last staff reset: when and by which user id.
  resetAt              DateTime?
  resetById            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("sms_gateway_binding")
}

/// The ONE phone-monitor PC the shared BANK_EVENTS_TOKEN is bound to
/// (audit 2026-10-09, SEC-004 / DB-015). A single row (id 1), the exact
/// twin of SmsGatewayBinding: the first X-Device-Serial that presents the
/// right token is pinned here; every other serial is refused with 401,
/// recorded as a rejection (and an audit row) so the admin card can warn.
/// A super admin clears the pin (DELETE /bank-events/binding) after the
/// monitor is reinstalled or moved to another PC; the next monitor to
/// present the token is then pinned.
model BankEventsBinding {
  id                       Int       @id @default(1)
  /// The pinned monitor's serial; null while nothing is pinned (fresh
  /// install, or right after a staff reset).
  deviceSerial             String?
  pinnedAt                 DateTime?
  /// The last monitor that presented the right token under another serial.
  lastRejectedDeviceSerial String?
  lastRejectedAt           DateTime?
  /// Refusals since the pin was set (cleared by a reset).
  rejectedCount            Int       @default(0)
  /// The last staff reset: when and by which user id.
  resetAt                  DateTime?
  resetById                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("bank_events_binding")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// A movie — or, when `seriesId` is set, one episode of a series. Episodes
/// deliberately reuse this model rather than getting their own: the entire
/// upload/validate/publish pipeline (UploadSession, Video, Subtitle,
/// streaming) is keyed on movieId, and an episode needs every bit of it
/// unchanged. Series-ness is purely additive metadata on top.
model Movie {
  id            String      @id @default(uuid())
  title         String
  description   String
  posterUrl     String?
  coverUrl      String?
  thumbnailUrl  String?
  genre         String
  language      String
  releaseYear   Int
  duration      Int // minutes
  rating        Float       @default(0)
  /// Optional catalog metadata added for the filter system (2026-09). All
  /// three are nullable — existing rows simply have no value, the admin
  /// forms treat them as optional, and the filter UI for each auto-hides
  /// until the facets endpoint reports at least one real value.
  director      String?
  /// The movie TYPE the admin picks (owner, 2026-10-27): "English", "Korean",
  /// "Chinese", "Thai", "Japanese", "Indian", "Myanmar" or "Other", shown as
  /// "Korean movie". It lives in this column (until then an unused free-text
  /// country) so nothing moved; the clients' labels key on these words.
  country       String?
  ageRating     AgeRating?
  /// For an episode (seriesId set), this is vestigial and never consulted —
  /// access is always inherited from the parent series' own accessType, the
  /// same way isPremium used to be inherited before this field existed.
  accessType    AccessType  @default(SUBSCRIPTION)
  status        MovieStatus @default(DRAFT)
  /// Set only for episodes — null means a standalone movie.
  seriesId      String?
  seasonNumber  Int?
  episodeNumber Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  categories             Category[]
  actors                 Actor[]
  videos                 Video[]
  purchases              Purchase[]
  watchHistory           WatchHistory[]
  watchActivity          WatchActivity[]
  comments               Comment[]
  uploadSessions         UploadSession[]
  advertisementTargets   AdvertisementMovie[]
  advertisementPlaybacks AdvertisementPlayback[]
  series                 Series?                 @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([seriesId, seasonNumber, episodeNumber])
  /// The public catalogue page: standalone movies (seriesId IS NULL) of one
  /// status, newest first, tie-broken by id — exactly the default
  /// RECENTLY_ADDED order. status is a key column rather than part of the
  /// WHERE so the index still matches when Prisma sends the status as a
  /// bound parameter; the predicate is a literal IS NULL, which Prisma
  /// renders as-is. Reads `limit` entries and stops instead of sorting the
  /// whole catalogue (and its episodes) on every page.
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "movies_standalone_recent_idx", where: raw("\"seriesId\" IS NULL"))
  // Search-box indexes (ILIKE '%term%' via pg_trgm) — see migration 20261103090000.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_description_trgm_idx")
  @@map("movies")
}

/// Show-level metadata for a series. Episodes are Movie rows pointing here
/// via seriesId — deleting a series CASCADES to its episodes (and, through
/// the Movie cascades, to their videos/subtitles/watch history), so no code
/// path can ever orphan an episode into the standalone movies list. Storage
/// cleanup for those episodes lives in SeriesService.remove().
model Series {
  id          String       @id @default(uuid())
  title       String
  description String
  posterUrl   String?
  coverUrl    String?
  genre       String
  language    String
  /// The series TYPE — the same words as Movie.country, shown as "Korean
  /// series". Null = not set. Episodes do not copy it: they follow the show.
  country     String?
  releaseYear Int
  /// Admin-set 0–10 rating, same meaning as Movie.rating: 0 = not rated yet.
  rating      Float        @default(0)
  /// The whole show is one product — episodes are never gated individually;
  /// this accessType governs every season and episode, including ones added
  /// later. An episode's own Movie.accessType is never consulted.
  accessType  AccessType   @default(SUBSCRIPTION)
  /// Show-level visibility: regular users only ever see PUBLISHED series.
  /// New series start DRAFT and go live only via an explicit admin publish.
  status      SeriesStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  episodes   Movie[]
  categories Category[]
  /// Show-level cast (implicit many-to-many, join table _ActorToSeries).
  /// Episodes keep their own Movie.actors; an actor "is in" a series when
  /// they are on the show itself OR on any of its episodes.
  actors     Actor[]
  purchases  SeriesPurchase[]
  comments   Comment[]

  // Ends in id to match every series list order ([createdAt desc, id desc]).
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  // Search-box indexes (ILIKE '%term%' via pg_trgm) — see migration 20261103090000.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "series_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "series_description_trgm_idx")
  @@map("series")
}

/// One user's ownership of a whole series — the series-level counterpart of
/// Purchase. Episode access is derived from this (via Movie.seriesId), never
/// from per-episode Purchase rows.
model SeriesPurchase {
  id        String   @id @default(uuid())
  userId    String
  seriesId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([seriesId])
  @@map("series_purchases")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  movies Movie[]
  series Series[]

  @@map("categories")
}

/// A person in a movie's cast.
///
/// `name` is unique so the admin cannot end up with three spellings of one
/// actor, which is the failure mode a free-text cast field always reaches —
/// the whole point of a row per person is that "everything they are in" is
/// one query rather than a string search.
///
/// How many movies an actor has is NOT stored: it is `_count.movies` on the
/// implicit join, so it can never drift from the truth the way a cached
/// counter does.
model Actor {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Headshot, persisted as an absolute URL like Movie.posterUrl (and
  /// re-hosted per request through MinioService.imageUrl). Optional: a cast
  /// list is useful before anyone has found photographs for it.
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movies Movie[]
  series Series[]

  // Search-box indexes (ILIKE '%term%' via pg_trgm) — see migration 20261103090000.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "actors_name_trgm_idx")
  @@map("actors")
}

// ---------------------------------------------------------------------------
// Books
// ---------------------------------------------------------------------------

/// A book as a WORK — one row per title, whatever languages it exists in.
///
/// Everything here is language-neutral by deliberate decision: the title,
/// author, description, cover and categories are shared, and only the
/// CONTENT differs per language. The content, its publish state and (for a
/// PDF book) its conversion state all live on BookEdition, one per language.
///
/// `type` stays here rather than on the edition: it describes how the work
/// is authored, and a title that is a scanned PDF in one language and typed
/// rich text in another would need two different readers for one book.
model Book {
  id          String   @id @default(uuid())
  title       String
  /// The display name every client reads. Since authors became rows this is
  /// a denormalised copy of `authorRef.name`, kept equal by BooksService on
  /// link and by BookAuthorsService on rename — never edited on its own.
  author      String
  /// The linked author row. Nullable only for rows that predate the link;
  /// the service links every book it creates or updates.
  authorId    String?
  description String
  coverUrl    String?
  type        BookType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorRef  BookAuthor?    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categories BookCategory[]
  editions   BookEdition[]
  comments   Comment[]

  @@index([type])
  @@index([authorId])
  // Search-box indexes (ILIKE '%term%' via pg_trgm) — see migration 20261103090000.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_title_trgm_idx")
  @@index([author(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_author_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_description_trgm_idx")
  @@map("books")
}

/// A person credited as the writer of books — the books' twin of Actor.
///
/// `Book.author` stays as the denormalised display name every client reads;
/// the service keeps it equal to `name` on link and on rename. How many
/// books an author has is `_count.books`, never a stored counter.
model BookAuthor {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Portrait, persisted absolute like Actor.imageUrl and re-hosted per request.
  imageUrl  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  // Search-box indexes (ILIKE '%term%' via pg_trgm) — see migration 20261103090000.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "book_authors_name_trgm_idx")
  @@map("book_authors")
}

/// A shelf in the library — the books' own taxonomy, deliberately NOT the
/// `Category` rows that movies and series share.
///
/// A book catalogue's vocabulary is its own: Manga, Manhwa, Light Novel,
/// Biography. Folding those into the movie categories meant every genre
/// invented for a book turned up in the movie picker and vice versa, which is
/// noise in both directions. Same shape as Category, separate table.
model BookCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  books Book[]

  @@map("book_categories")
}

/// One language of one book: its content, and its own place in the
/// lifecycle.
///
/// Publishing is per edition — a finished Burmese translation goes live
/// while the English one is still being converted, and readers are only
/// offered the languages that are actually PUBLISHED. A Book therefore has
/// no status of its own; it is visible exactly when one of these is.
model BookEdition {
  id       String @id @default(uuid())
  bookId   String
  /// Language code for this edition, e.g. "my", "en" — an open string like
  /// Movie.language rather than an enum, so a new language is a dropdown
  /// entry in the admin, never a migration.
  language String

  status      BookStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  book            Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapters        BookChapter[]
  parts           BookPart[]
  readingProgress BookReadingProgress[]

  /// One edition per language per book — adding a language twice is a
  /// mistake, not a second edition.
  @@unique([bookId, language])
  @@index([status])
  @@map("book_editions")
}

/// One chapter of one language — and now the unit of content for BOTH book
/// types, which is the point of this model.
///
/// A written chapter holds `content`: the TipTap/ProseMirror JSON document,
/// stored as structured JSON (not HTML) so the admin editor and the reader
/// render it through the same schema and no raw markup is ever persisted or
/// replayed.
///
/// A PDF chapter instead holds its OWN uploaded file and the pages converted
/// from it — one release per chapter, the way serialised comics actually
/// ship. That is why the pdf* columns and `status` live here rather than on
/// the edition: two chapters of the same language convert independently, and
/// one failing must not stall the rest.
model BookChapter {
  id        String        @id @default(uuid())
  editionId String
  title     String
  /// Optional cover for the chapter — the thumbnail a chapter list shows.
  /// Available to BOTH types; an absolute URL like Book.coverUrl, not a key.
  imageUrl  String?
  /// Written chapters only. NULL on a PDF chapter, whose content is `pages`.
  content   Json?
  /// 1-based position within its edition. Renumbered sequentially on
  /// reorder, the same way series episodes renumber episodeNumber. Chapter
  /// counts may legitimately differ between languages.
  order     Int
  status    ChapterStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  /// PDF chapters only — MinIO object KEY of this chapter's uploaded SOURCE
  /// file (documents/books/<bookId>/<editionId>/<chapterId>/original.pdf),
  /// never an absolute URL, so the stored value survives host changes. It
  /// sits under documents/, not books/: books/ holds only the GENERATED
  /// reader pages, while the whole documents/ namespace is denied at the
  /// cache server and unsignable, so a source PDF can never be handed out.
  /// Keys stay nested under the BOOK on both sides, so deleting a book still
  /// cleans every language and every chapter with a fixed pair of prefix
  /// deletes — `books/<bookId>/` and `documents/books/<bookId>/`, which is
  /// what BooksService.remove issues.
  pdfKey          String?
  /// PDF chapters only — size of this chapter's file in bytes.
  pdfFileSize     BigInt?
  /// PDF chapters only — pages the file reports. 0 until it has been probed.
  pageCount       Int     @default(0)
  /// PDF chapters only — pages converted and uploaded so far; with pageCount
  /// this is the admin's real progress figure.
  processedPages  Int     @default(0)
  /// PDF chapters only — why the conversion FAILED, shown next to the retry
  /// action. Cleared when a retry starts.
  processingError String?
  /// PDF chapters only — ETag of the source PDF the stored `pages` were
  /// converted from (H-23). The PDF sits at one fixed key, so a re-upload
  /// overwrites it: a conversion resumes the existing pages only when the
  /// file it downloaded has this exact ETag, and otherwise clears them and
  /// converts from page 1 into a fresh pages/v-<tag>/ folder. NULL = no
  /// pages yet, or pages made before this was tracked (never resumed).
  pagesSourceEtag String?

  /// Optional grouping above chapters. NULL = no part; unparted chapters read
  /// before the first part. SetNull so deleting a part keeps its chapters.
  partId String?

  edition         BookEdition           @relation(fields: [editionId], references: [id], onDelete: Cascade)
  part            BookPart?             @relation(fields: [partId], references: [id], onDelete: SetNull)
  pages           BookPage[]
  sections        BookSection[]
  readingProgress BookReadingProgress[]

  @@index([editionId, order])
  @@index([partId])
  @@map("book_chapters")
}

/// An optional grouping of chapters ("Part 1", "Book Two") inside ONE edition.
/// Purely structural: it owns no content. Numbered by position, never stored.
model BookPart {
  id        String   @id @default(uuid())
  editionId String
  title     String
  /// 1-based position among the edition's parts. Renumbered on reorder.
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition  BookEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  chapters BookChapter[]

  @@index([editionId, order])
  @@map("book_parts")
}

/// An optional subdivision INSIDE a chapter. A written section carries its own
/// TipTap JSON; a PDF section is a page anchor (startPage) whose range ends
/// where the next section starts. A chapter with no sections renders exactly
/// as before - that is how every existing book keeps working untouched.
model BookSection {
  id        String   @id @default(uuid())
  chapterId String
  title     String
  /// 1-based position within its chapter. PDF sections are kept sorted by startPage.
  order     Int
  /// EDITOR books only - the section's own TipTap/ProseMirror JSON document.
  content   Json?
  /// PDF books only - 1-based page within the chapter where this section starts.
  startPage Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter         BookChapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  readingProgress BookReadingProgress[]

  @@index([chapterId, order])
  @@map("book_sections")
}

/// One converted page of a PDF CHAPTER: the WebP object in MinIO plus the
/// dimensions the reader needs to reserve layout space before the image
/// loads. Created only AFTER the object is uploaded, so the row's existence
/// is the idempotent "this page is done" marker a retry can resume from.
model BookPage {
  id         String @id @default(uuid())
  chapterId  String
  /// 1-based WITHIN ITS CHAPTER — page 1 of chapter 2 is a real page 1, the
  /// way a serialised release numbers itself.
  pageNumber Int
  /// MinIO object KEY
  /// (books/<bookId>/<editionId>/<chapterId>/pages/page-001.webp) — see
  /// BookChapter.pdfKey for why keys, not URLs, are persisted.
  imageKey   String
  width      Int
  height     Int
  fileSize   Int

  chapter BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageNumber])
  @@map("book_pages")
}

/// One user's reading position in one EDITION — WatchHistory's shape, for
/// books. Keyed on the edition rather than the book because the same title
/// in two languages is two different reads: chapter counts and page counts
/// need not line up, so one shared bookmark could not mean anything in both.
model BookReadingProgress {
  id         String   @id @default(uuid())
  userId     String
  editionId  String
  /// EDITOR editions — the chapter the reader was last in. SetNull so
  /// deleting a chapter demotes the bookmark instead of erasing the row.
  chapterId  String?
  /// PDF editions — 1-based page the reader was last on.
  pageNumber Int?
  /// The section the reader was last in, when the reader knows it. SetNull
  /// like chapterId.
  sectionId  String?
  progress   Float    @default(0) // percent 0-100
  updatedAt  DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition BookEdition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  chapter BookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  section BookSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([userId, editionId])
  @@index([editionId])
  @@index([chapterId])
  @@index([sectionId])
  @@map("book_reading_progress")
}

// ---------------------------------------------------------------------------
// Video pipeline
// ---------------------------------------------------------------------------

/// Metadata only — the actual bytes live on local disk under STORAGE_PATH.
model Video {
  id               String      @id @default(uuid())
  movieId          String
  originalFilename String
  originalPath     String
  duration         Int? // seconds, populated after ffprobe inspection
  resolution       String? // source resolution, e.g. "1920x1080"
  status           VideoStatus @default(UPLOADING)
  hlsMasterPath    String? // path to master.m3u8 once processing finishes
  renditions       Json? // [{ resolution: "1080p", playlistPath, segmentDir }, ...]
  failureReason    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  subtitles Subtitle[]

  @@index([movieId])
  @@map("videos")
}

/// A subtitle track for a Video — either uploaded by an admin against the
/// classic transcode flow, or as part of an externally pre-transcoded
/// bundle. Not yet consumed by the player (no format conversion, no
/// language-switch UI) — this just stores and exposes the tracks via the
/// video API response.
model Subtitle {
  id        String         @id @default(uuid())
  videoId   String
  language  String // e.g. "en", "my"
  label     String // e.g. "English", "Myanmar"
  format    SubtitleFormat
  /// MinIO key of the uploaded SOURCE file, always foldered by the OWNING
  /// MOVIE: subtitles/<movieId>/<filename>. A single upload names the file
  /// after this row's id (subtitles/<movieId>/<subtitleId>.srt — a video can
  /// have more than one track per language, so the language is not unique);
  /// an external bundle keeps the operator's own basename
  /// (subtitles/<movieId>/english.vtt), which is how they identify the
  /// track. Keying by movie is what lets the one `subtitles/<movieId>` scope
  /// sign every track /stream hands out, whichever path uploaded it.
  objectKey String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("subtitles")
}

/// Tracks an in-progress chunked upload so it can be resumed after a client
/// disconnect. Rows are cleaned up once the upload completes.
model UploadSession {
  id           String       @id @default(uuid())
  movieId      String
  filename     String
  fileSize     BigInt
  chunkSize    Int
  totalChunks  Int
  tempDir      String
  status       UploadStatus @default(IN_PROGRESS)
  /// Set only for the externally-pre-transcoded upload flow — the path of
  /// this file INSIDE the bundle the operator dropped, e.g. "original.mkv",
  /// "hls/720p/index.m3u8", "hls/720p/segment_000.ts", "subtitles/english.vtt".
  /// Null means the classic single-video-file flow (unchanged behavior):
  /// completeUpload() merges into the movie's original file and kicks off
  /// transcoding. When set, completeUpload() instead uploads the merged file
  /// to whatever object key ResourceUploadTypeRegistry.buildKey maps this
  /// relativePath onto, and does nothing else — no Video row, no
  /// processVideo() call. That mapping is NOT a plain join: video assets land
  /// under `videos/<movieId>/<relativePath>`, but a "subtitles/" path is a
  /// SOURCE file and is routed out of the video prefix to
  /// `subtitles/<movieId>/<basename>`.
  relativePath String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
  /// Daily cleanup sweeps filter on status + updatedAt age.
  @@index([status, updatedAt])
  @@map("upload_sessions")
}

/// Tracks a direct browser->MinIO multipart upload (the presigned-URL flow
/// that bypasses UploadSession/local disk entirely for pre-transcoded
/// assets — see backend/src/uploads/multipart-upload.service.ts). Rows only
/// ever exist for the one large file in a bundle (typically original.mp4);
/// small files (playlists, subtitles, segments) go through a single
/// presigned PUT with no row at all. MinIO's own ListPartsCommand is always
/// the source of truth for which parts have landed — this table
/// deliberately never stores a per-part list, only enough to reconstruct
/// what MinIO already knows (mirrors why UploadSession.uploadedChunks was
/// removed in favor of a disk listing).
model MultipartUploadSession {
  id            String       @id @default(uuid())
  /// Open string, not an enum — a new resource type (e.g. "book") needs a
  /// new key-builder + permission mapping in application code, never a
  /// migration. "movie" is the only value that exists today.
  resourceType  String
  /// The owning row's id in whatever table resourceType names. Deliberately
  /// not a Prisma @relation — a hard FK can only ever point at one table,
  /// which would defeat the point of this being resource-type-generic.
  /// Existence is validated in application code before a session is
  /// created; the cleanup cron's age-based sweep bounds the blast radius of
  /// any bug that lets that check slip.
  resourceId    String
  /// Full MinIO object key, e.g. "videos/<movieId>/original.mp4".
  objectKey     String
  fileSize      BigInt
  partSize      Int
  totalParts    Int
  minioUploadId String
  status        UploadStatus @default(IN_PROGRESS)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([resourceType, resourceId])
  /// Daily cleanup sweeps filter on status + updatedAt age, and match MinIO
  /// uploads back to rows by minioUploadId.
  @@index([status, updatedAt])
  @@index([minioUploadId])
  @@map("multipart_upload_sessions")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
  @@map("purchases")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String
  type      TransactionType
  amount    Decimal           @db.Decimal(12, 2)
  status    TransactionStatus @default(COMPLETED)
  movieId   String?
  createdAt DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletAdjustment WalletAdjustment?
  /// Back-relation only: the withdrawal whose held money this row records (C-4).
  heldWithdrawal   Withdrawal?       @relation("WithdrawalHold")
  /// Back-relation only: the lottery purchase this LOTTERY_PURCHASE row paid for.
  lotteryPurchase  LotteryPurchase?
  /// Back-relation only: the lottery prize this LOTTERY_PRIZE row paid (phase 3,
  /// one row per ticket for the draws paid at publish before 2026-10-24).
  lotteryPayout    LotteryPayout?
  /// Back-relation only: the prize claim this LOTTERY_PRIZE row paid (one
  /// row per confirmed claim, covering every ticket in it).
  lotteryClaim     LotteryClaim?

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("transactions")
}

/// Audit record of one admin-initiated wallet balance correction — always
/// paired with a Transaction row (ADJUSTMENT_CREDIT/ADJUSTMENT_DEBIT) created
/// in the same $transaction. Append-only, mirroring the
/// PaymentAccountTransaction convention.
model WalletAdjustment {
  id                String                    @id @default(uuid())
  userId            String
  direction         WalletAdjustmentDirection
  /// Always a positive magnitude; direction carries the sign.
  amount            Decimal                   @db.Decimal(12, 2)
  balanceBefore     Decimal                   @db.Decimal(12, 2)
  balanceAfter      Decimal                   @db.Decimal(12, 2)
  reason            String
  /// Client-generated per dialog-open; unique = server-side duplicate guard.
  idempotencyKey    String                    @unique
  performedByUserId String?
  transactionId     String?                   @unique
  createdAt         DateTime                  @default(now())

  user        User         @relation("WalletAdjustmentUser", fields: [userId], references: [id], onDelete: Restrict)
  performedBy User?        @relation("WalletAdjustmentPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([performedByUserId])
  @@index([createdAt])
  @@map("wallet_adjustments")
}

/// A user-submitted balance top-up request awaiting admin review. Approving
/// one credits the Wallet and creates a matching Transaction — the deposit
/// itself never touches the ledger directly, so a rejected request leaves no
/// trace on the Wallet/Transaction tables at all.
model Deposit {
  id                        String          @id @default(uuid())
  userId                    String
  amount                    Decimal         @db.Decimal(12, 2)
  paymentMethod             String
  /// The PaymentAccount.accountName the depositor says they sent to, as a
  /// plain snapshot string (same free-text convention as paymentMethod) —
  /// not a foreign key, so it survives that PaymentAccount later being
  /// renamed or deleted. Null for deposits submitted before this field
  /// existed, or from a client that hasn't been updated to send it.
  accountName               String?
  /// 6-digit payment reference, e.g. "000123" — stored as a string so
  /// leading zeros survive; validated at the DTO layer, not the DB.
  reference                 String
  /// The catalog PaymentAccount the depositor picked as their destination at
  /// submission time (captured from the deposit dialog's account picker) —
  /// what they CLAIM they sent to, not yet confirmed. Deliberately distinct
  /// from receivingPaymentAccountId (the confirmed/ledgered account): if they
  /// were the same field, approve() crediting this account wouldn't be
  /// distinguishable from "nothing changed" once it's already set. Null for
  /// deposits from a client that hasn't been updated to send it.
  declaredPaymentAccountId  String?
  status                    DepositStatus   @default(PENDING)
  rejectionReason           String?
  approvedByUserId          String?
  approvedAt                DateTime?
  /// The account WE received the money INTO (our own KPay/bank/etc.),
  /// recorded manually by an admin after approval — entirely separate from
  /// paymentMethod/accountName above, which describe what the user says they
  /// sent FROM and are never touched by this. Mirrors Withdrawal's
  /// transferAccount* fields (see that model's doc comments).
  receivingAccountType      String?
  /// Copied from PaymentAccount.subname at save time when the admin picks a
  /// configured account (see ReceivingAccountCell) — a short internal label
  /// (e.g. "K1") that reads better than the account holder's real name in
  /// the compact table view. Null when the admin typed the account in
  /// manually instead of picking one from the catalog.
  receivingAccountSubname   String?
  receivingAccountName      String?
  receivingAccountNumber    String?
  /// Last 6 characters (alphanumeric) of the transaction code, keyed in by
  /// the admin from the payment provider's confirmation — not the full code.
  receivingTransactionCode  String?
  /// Time of day only (no date), e.g. "06:56:28" — see
  /// UpdateReceivingAccountDto for the normalization/validation rules.
  receivingTransactionTime  String?
  /// Set when the admin picks a catalog PaymentAccount (rather than typing
  /// the receiving account in free text) via updateReceivingAccount — this
  /// is what lets PaymentAccountLedgerService.syncDepositLink post a
  /// DEPOSIT_IN ledger entry against that specific account. Null if never
  /// picked from the catalog, in which case no ledger entry is ever created
  /// for this deposit.
  receivingPaymentAccountId String?
  /// Customer wallet balance immediately before/after this deposit's credit —
  /// captured at approve/manual-create time; null for deposits credited
  /// before these columns existed and for PENDING/REJECTED deposits.
  walletBalanceBefore       Decimal?        @db.Decimal(12, 2)
  walletBalanceAfter        Decimal?        @db.Decimal(12, 2)
  /// What the BANK said, written by the matcher only (bank-events module)
  /// — never by an admin form. Null until a phone-monitor event matched
  /// this row.
  receivingAmount           Decimal?        @db.Decimal(12, 2)
  /// Full timestamp of the bank notification. The old time-of-day column
  /// receivingTransactionTime stays and is filled from this in Asia/Yangon,
  /// as an admin would have typed it.
  receivingTransactionAt    DateTime?
  /// Private object key (documents/bank-screenshots/deposits/<id>/…) — never
  /// a URL; the admin only ever learns `hasBankScreenshot`, and the bytes
  /// are streamed through GET /deposits/:id/bank-screenshot behind
  /// DEPOSITS.BANK_EVIDENCE.
  receivingScreenshotKey    String?
  /// The phone event's idempotency key. UNIQUE: one bank notification can
  /// credit at most one deposit, and a retried event is recognised as
  /// already applied instead of being applied twice.
  receivingEventKey         String?         @unique(map: "deposits_receivingEventKey_key")
  /// Set once, when a bank event was applied. IS NULL = still in the open
  /// set the matcher searches; that predicate is what keeps every partial
  /// index below tiny (work scales with transfers that happen, never rows
  /// that exist).
  bankCheckedAt             DateTime?
  matchStatus               BankMatchStatus @default(UNVERIFIED)
  riskLevel                 BankRiskLevel?
  /// Sorted, de-duplicated reason codes (bank-events/risk-rules.ts) — a set,
  /// so recomputation is idempotent. NO_BANK_TRANSACTION is never stored.
  riskReasons               String[]        @default([])
  /// When the user says they transferred (the mobile form does not send it
  /// yet; rules treat null as "use createdAt").
  declaredTransferAt        DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                    User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy              User?                       @relation("DepositApprovals", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  declaredPaymentAccount  PaymentAccount?             @relation("DepositDeclaredAccount", fields: [declaredPaymentAccountId], references: [id], onDelete: SetNull)
  receivingPaymentAccount PaymentAccount?             @relation("DepositReceivingAccount", fields: [receivingPaymentAccountId], references: [id], onDelete: SetNull)
  ledgerEntries           PaymentAccountTransaction[] @relation("DepositLedgerEntries")
  /// Back-relation only (no column here): the stored phone event that
  /// claimed this deposit, when one did. bank_transactions.linkedDepositId
  /// is UNIQUE, so it is at most one.
  bankTransaction         BankTransaction?            @relation("BankTransactionDeposit")

  /// One LIVE deposit per reference PER USER (H-11, 2026-09-28) — a double
  /// submit by the same user is still refused by the database, so concurrent
  /// taps cannot slip past the service-level pre-check (P2002 → 409 in
  /// DepositsService). Different users MAY share a 6-digit reference: the
  /// last-6 is not a secret, so a global rule let whoever typed it first own
  /// it and refused the real payer. Such twins are stored and flagged
  /// (DUPLICATE_REFERENCE / SHARED_REFERENCE_ACROSS_USERS → staff review),
  /// and the matcher never picks between two open ones (AMBIGUOUS).
  /// REJECTED is excluded so a user can resubmit after a mistaken rejection.
  /// The predicate is written the way Postgres stores it (`= ANY (ARRAY[...])`
  /// rather than `IN (...)`) so `prisma migrate diff` sees no drift.
  /// The plain @@index([reference]) below stays: the twin lookup and list
  /// queries search by reference alone, across users and statuses.
  /// Side effect of the partial @@unique: the generated client lists
  /// `userId_reference` in DepositWhereUniqueInput — never findUnique/upsert
  /// by it, it is only unique among PENDING/APPROVED rows.
  @@unique([userId, reference], where: raw("status = ANY (ARRAY['PENDING'::\"DepositStatus\", 'APPROVED'::\"DepositStatus\"])"), map: "deposits_user_reference_active_key")
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@index([declaredPaymentAccountId])
  @@index([receivingPaymentAccountId])
  /// Staff-account deletion SETs NULL here; without an index that is a scan.
  @@index([approvedByUserId])
  /// The OPEN SET — deposits still waiting for their bank notification. A
  /// row enters it at create and leaves it for good the moment it is
  /// matched, approved or rejected, so these three partial indexes hold
  /// "today's unmatched deposits", never history. The bank-events matcher
  /// and the two open-set admin filters query them with the predicate
  /// spelled out as literal SQL ($queryRaw) — a parameterised
  /// `status = $n` cannot prove it implies the index predicate.
  ///   open_match   — Q1: the user's own last-6 on the declared account.
  ///   open_created — the "awaiting bank" / "no bank transaction" filters.
  /// (open_amount, the amount-fallback index, was dropped on 2026-09-22 with
  /// the fallback itself — see deposit-matcher.ts.)
  @@index([declaredPaymentAccountId, reference], map: "deposits_open_match_idx", where: raw("status = 'PENDING'::\"DepositStatus\" AND \"bankCheckedAt\" IS NULL"))
  @@index([createdAt], map: "deposits_open_createdAt_idx", where: raw("status = 'PENDING'::\"DepositStatus\" AND \"bankCheckedAt\" IS NULL"))
  /// VELOCITY = "rows by this user inside the last few minutes" — reads
  /// only the rows inside the window, where a userId-only index would read
  /// a heavy user's whole history and filter createdAt per row. Also serves
  /// every userId-only lookup and the user FK (it replaced the separate
  /// deposits_userId_idx on 2026-10-07).
  @@index([userId, createdAt])
  /// The "verified" / "needs review" admin filters ordered by createdAt
  /// DESC — a paginated scan reads `limit` entries and stops. Not partial:
  /// a needs-review row must stay findable across any date range.
  @@index([matchStatus, createdAt])
  @@map("deposits")
}

/// A user-submitted payout request awaiting admin review — the mirror image
/// of Deposit. Since C-4 (2026-09-28) the money is HELD when the request is
/// made: the Wallet is debited and a PENDING WITHDRAWAL Transaction is
/// written in the same transaction as the insert (holdTransactionId points
/// at it). Approving only turns that row COMPLETED; rejecting credits the
/// Wallet back, turns it FAILED and writes a REFUND Transaction. Rows from
/// before C-4 have no hold (holdTransactionId null): approving one still
/// debits and writes a COMPLETED WITHDRAWAL row, rejecting one moves no
/// money. Unlike Deposit's `accountName` (who the user says they sent
/// FROM), these three fields describe where the admin should send money TO.
model Withdrawal {
  id                       String           @id @default(uuid())
  userId                   String
  amount                   Decimal          @db.Decimal(12, 2)
  /// Free string, same convention as PaymentAccount.type / PaymentMethodType
  /// — not a foreign key. Typically one of the known payment method labels
  /// (KBZPay, Bank Account, ...) but not enforced against that catalog,
  /// since it describes the user's own external account, not a platform one.
  accountType              String
  accountName              String
  accountNumber            String
  /// The bank the user named on THIS request, captured only when the chosen
  /// accountType requires one (see PaymentMethodType.requiresBankName). Part
  /// of the same user-provided snapshot as the three fields above: it records
  /// what they asked us to pay out to on this occasion, which may differ from
  /// any bank on their profile or on a previous request, and is never
  /// back-filled or overwritten from either. Null for non-bank methods, and
  /// for requests submitted before this field existed.
  bankName                 String?
  status                   WithdrawalStatus @default(PENDING)
  rejectionReason          String?
  approvedByUserId         String?
  approvedAt               DateTime?
  /// The account WE sent the money FROM (our own KBZPay/bank/etc.), recorded
  /// manually by an admin after approval — entirely separate from
  /// accountType/accountName/accountNumber above, which describe the user's
  /// own destination account and are never touched by this.
  transferAccountType      String?
  /// Copied from PaymentAccount.subname at save time when the admin picks a
  /// configured account (see TransferAccountCell) — a short internal label
  /// (e.g. "K1") that reads better than the account holder's real name in
  /// the compact table view. Null when the admin typed the account in
  /// manually instead of picking one from the catalog.
  transferAccountSubname   String?
  transferAccountName      String?
  transferAccountNumber    String?
  /// Last 6 characters (alphanumeric) of the transaction code, keyed in by
  /// the admin from the payment provider's confirmation — not the full code.
  transferTransactionCode  String?
  /// The actual time the transfer happened (per the provider's receipt), as
  /// free text — a plain record of what the admin typed, not a parsed/
  /// validated timestamp, since the provider's receipt format varies.
  transferTransactionTime  String?
  /// Set when the admin picks a catalog PaymentAccount (rather than typing
  /// the transferring account in free text) via updateTransferAccount — this
  /// is what lets PaymentAccountLedgerService.syncWithdrawalLink post a
  /// WITHDRAWAL_OUT ledger entry against that specific account. Null if
  /// never picked from the catalog, in which case no ledger entry is ever
  /// created for this withdrawal.
  transferPaymentAccountId String?
  /// What the BANK said ("You sent …"), written by the matcher only —
  /// mirrors Deposit.receivingAmount and friends with transfer* naming.
  transferAmount           Decimal?         @db.Decimal(12, 2)
  /// Full timestamp of the bank notification; transferTransactionTime (the
  /// legacy time-of-day text) is filled from this in Asia/Yangon.
  transferTransactionAt    DateTime?
  /// Private object key (documents/bank-screenshots/withdrawals/<id>/…) —
  /// never a URL, streamed only behind WITHDRAWALS.BANK_EVIDENCE.
  transferScreenshotKey    String?
  /// The phone event's idempotency key — UNIQUE, so one "sent" notification
  /// confirms at most one payout and a retry is recognised, not re-applied.
  transferEventKey         String?          @unique(map: "withdrawals_transferEventKey_key")
  /// Set once, when a bank event was applied. IS NULL = still in the open
  /// payout set the matcher searches.
  bankCheckedAt            DateTime?
  matchStatus              BankMatchStatus  @default(UNVERIFIED)
  riskLevel                BankRiskLevel?
  /// Sorted, de-duplicated reason codes — see bank-events/risk-rules.ts.
  riskReasons              String[]         @default([])
  /// C-4 — the wallet-ledger row of the hold taken when this request was
  /// made (a WITHDRAWAL Transaction: PENDING while the request is open,
  /// COMPLETED on approve, FAILED on reject). Non-null = the money already
  /// left the balance, so approve must NOT debit again. Null only on rows
  /// created before holds existed — approve debits those as it always did.
  /// RESTRICT: a ledger row that backs a hold can never be deleted.
  holdTransactionId        String?          @unique
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user                   User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy             User?                       @relation("WithdrawalApprovals", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  holdTransaction        Transaction?                @relation("WithdrawalHold", fields: [holdTransactionId], references: [id], onDelete: Restrict)
  transferPaymentAccount PaymentAccount?             @relation("WithdrawalTransferAccount", fields: [transferPaymentAccountId], references: [id], onDelete: SetNull)
  ledgerEntries          PaymentAccountTransaction[] @relation("WithdrawalLedgerEntries")
  /// Back-relation only — see Deposit.bankTransaction.
  bankTransaction        BankTransaction?            @relation("BankTransactionWithdrawal")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([transferPaymentAccountId])
  /// The user-relationships search looks withdrawals up by payout account
  /// number (accountNumber IN (...)) on every wave.
  @@index([accountNumber])
  /// Staff-account deletion SETs NULL here; without an index that is a scan.
  @@index([approvedByUserId])
  /// DUPLICATE_PAYOUT_CODE = "this payout code already sits on another
  /// withdrawal". Without an index that check is a sequential scan. Plain,
  /// not unique: the decision is flag-not-block.
  @@index([transferTransactionCode])
  /// The OPEN PAYOUT SET — approved, not yet bank-checked, no code keyed in
  /// by hand. The withdrawal matcher ("You sent …") searches it by amount +
  /// approvedAt window with the predicate as literal SQL; a row leaves it
  /// when matched or when an admin records the code manually.
  @@index([amount, approvedAt], map: "withdrawals_open_payout_idx", where: raw("status = 'APPROVED'::\"WithdrawalStatus\" AND \"bankCheckedAt\" IS NULL AND \"transferTransactionCode\" IS NULL"))
  /// Same open payout set, keyed by createdAt: the "awaiting bank" / "no bank
  /// transaction" admin filters page the open set ORDER BY createdAt DESC,
  /// and the payout index above cannot serve that order (amount comes
  /// first). Without this, EXPLAIN on 50k rows walked withdrawals_createdAt_idx
  /// and threw away thousands of finished rows to fill one page — work that
  /// grows with rows that exist. Mirrors deposits_open_createdAt_idx.
  @@index([createdAt], map: "withdrawals_open_createdAt_idx", where: raw("status = 'APPROVED'::\"WithdrawalStatus\" AND \"bankCheckedAt\" IS NULL AND \"transferTransactionCode\" IS NULL"))
  /// The CODED PAYOUT SET — not yet bank-checked, code keyed in by hand
  /// (only an APPROVED row can carry one). When a "You sent …" record
  /// arrives, the withdrawal matcher first looks here for a withdrawal whose
  /// typed code is the record's last 6 (ignoring case) approved within 24 h
  /// either side of the bank time. Keyed by approvedAt so that window is one
  /// range scan whatever the history; the predicate is two IS [NOT] NULL
  /// tests, which Prisma renders literally, so its own (case-insensitive)
  /// findMany can use this index — status stays a filter.
  @@index([approvedAt], map: "withdrawals_coded_payout_idx", where: raw("\"bankCheckedAt\" IS NULL AND \"transferTransactionCode\" IS NOT NULL"))
  /// Same role as deposits_matchStatus_createdAt_idx.
  @@index([matchStatus, createdAt])
  @@map("withdrawals")
}

/// Every bank notification a phone-monitor captured, stored BEFORE any
/// matching is attempted (store-first, owner decision 2026-09-22: "every tx
/// record of each phone on the admin side"). The one new table the
/// payment-verification feature is allowed. A deposit/withdrawal still
/// carries the bank's values in its own receiving… / transfer… columns; this
/// row is the evidence that stays even when no deposit ever claims it, and
/// the link between the two is what lets a deposit submitted AFTER its
/// transfer match at create time instead of waiting for the phone's retry.
model BankTransaction {
  id                 String                   @id @default(uuid())
  /// The phone's sha256 event key — UNIQUE, so a re-post never duplicates.
  idempotencyKey     String                   @unique(map: "bank_transactions_idempotencyKey_key")
  deviceSerial       String
  paymentAccountId   String
  direction          BankTransactionDirection
  amount             Decimal                  @db.Decimal(12, 2)
  currency           String                   @default("MMK")
  /// The full code as the bank printed it; txCodeLast6 is what a user is
  /// asked to type and what the match lookup keys on.
  txCode             String
  txCodeLast6        String
  /// The BANK's time (voucher) — the match/list axis.
  occurredAt         DateTime
  /// The notification's post time (phone), kept for the audit trail.
  postedAt           DateTime
  counterparty       String?
  /// Private object key documents/bank-screenshots/transactions/<id>/<key>.png
  /// — never a URL. When the row is linked, the deposit's/withdrawal's own
  /// screenshot column points at this SAME key (no copy).
  screenshotKey      String?
  /// What the phone's KBZPay detail flow reported (ok | locked | … |
  /// not_needed), free text.
  detailStatus       String?
  state              BankTransactionState     @default(UNMATCHED)
  /// UNIQUE: one transaction per deposit / per withdrawal (NULLs are free in
  /// a Postgres unique index). SET NULL on delete leaves `state` MATCHED with
  /// both links null — the view reads that as WAITING, nothing sweeps it.
  linkedDepositId    String?                  @unique(map: "bank_transactions_linkedDepositId_key")
  linkedWithdrawalId String?                  @unique(map: "bank_transactions_linkedWithdrawalId_key")
  matchedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  /// RESTRICT: a business account with bank evidence behind it cannot be
  /// deleted (PaymentAccountsService.remove guards this with a 409, like
  /// its ledger guard).
  paymentAccount   PaymentAccount @relation("BankTransactionAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  /// A deleted deposit/withdrawal (user cascade) leaves the transaction
  /// UNLINKED, never deleted: it is evidence.
  linkedDeposit    Deposit?       @relation("BankTransactionDeposit", fields: [linkedDepositId], references: [id], onDelete: SetNull)
  linkedWithdrawal Withdrawal?    @relation("BankTransactionWithdrawal", fields: [linkedWithdrawalId], references: [id], onDelete: SetNull)

  /// THE OPEN SET — "You received …" rows nobody has claimed. Deposit
  /// creation and ingestion look up (account, last-6) here with the
  /// predicate spelled out as literal SQL, exactly like deposits_open_match_idx
  /// (a bound `state = $n` cannot prove it implies the predicate). Holds
  /// today's unclaimed transfers, never history. `direction` is in the
  /// predicate, not the key: two values would always be a heap filter.
  @@index([paymentAccountId, txCodeLast6], map: "bank_transactions_open_received_idx", where: raw("state = 'UNMATCHED'::\"BankTransactionState\" AND direction = 'RECEIVED'::\"BankTransactionDirection\""))
  /// The admin list: by phone / by account / everything, newest bank time
  /// first. Each is (leading equality, occurredAt DESC) so ORDER BY and the
  /// date range come free and a page reads limit+offset entries, then stops.
  @@index([deviceSerial, occurredAt(sort: Desc)])
  @@index([paymentAccountId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  /// The matched / ambiguous / waiting / unclaimed filters — unclaimed is
  /// `state = UNMATCHED AND occurredAt < now - 48 h`, one contiguous range.
  @@index([state, occurredAt(sort: Desc)])
  /// The Received / Sent filter on its own. Two values, but behind them
  /// occurredAt DESC makes it a band in time order — the same shape as the
  /// state index — so a "Sent" list or its capped count with no phone
  /// selected reads limit+offset entries and stops. Without it that one
  /// combination was a sequential scan at 200k rows (EXPLAIN, 2026-09-23).
  @@index([direction, occurredAt(sort: Desc)])
  @@map("bank_transactions")
}

/// Single global row holding admin-configurable transaction limits, lazily
/// created with defaults on first read. Amounts use the app's one currency
/// (Kyat) — no separate currency field, matching every other money field.
model FinanceSettings {
  id                  String   @id @default(uuid())
  minDepositAmount    Decimal  @db.Decimal(12, 2)
  maxDepositAmount    Decimal  @db.Decimal(12, 2)
  minWithdrawalAmount Decimal  @db.Decimal(12, 2)
  maxWithdrawalAmount Decimal  @db.Decimal(12, 2)
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  updatedBy User? @relation("FinanceSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("finance_settings")
}

/// Single global row tracking the concurrent-user peak. `actualPeak` is the
/// real tracked high-water mark (never edited by hand); `additionalPeak` is
/// an admin-set marketing adjustment (>= 0, resettable to 0). Public callers
/// only ever see the combined total — the split stays admin-only.
model PeakUserStats {
  id              String    @id @default(uuid())
  actualPeak      Int       @default(0)
  actualPeakAt    DateTime?
  additionalPeak  Int       @default(0)
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  updatedBy User? @relation("PeakUserStatsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("peak_user_stats")
}

/// An admin-managed destination (KBZPay, bank account, etc.) shown to users
/// when depositing — replaces what used to be a payment-method list
/// hardcoded separately in each client app. `type` is a free string, not an
/// enum or a foreign key, matching the same convention as
/// Deposit.paymentMethod — it always equals some PaymentMethodType.label.
/// Renaming a PaymentMethodType cascades and rewrites every matching `type`
/// value here so the two never drift apart (see
/// PaymentAccountsService.updateType).
model PaymentAccount {
  id            String  @id @default(uuid())
  type          String
  /// Admin-facing label distinguishing multiple accounts under the same
  /// `type` (e.g. "Main Account" vs "Backup Account" for KBZPay) — never
  /// shown to users during deposit, and never used as the actual account
  /// name that gets sent anywhere.
  subname       String?
  accountName   String
  /// Account number or phone number, depending on type.
  accountNumber String
  /// Only meaningful for bank-transfer types; null otherwise.
  bankName      String?
  note          String?
  isActive      Boolean @default(true)

  /// Running balance — a cache, not the source of truth. The real audit
  /// trail is PaymentAccountTransaction; this column (and totalIn/totalOut
  /// below) is only ever updated by PaymentAccountLedgerService inside the
  /// same $transaction as the ledger row that explains the change. Never
  /// part of Create/UpdatePaymentAccountDto — that omission is what keeps
  /// this non-editable directly by an admin.
  balance  Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of every credit ever posted to this account (opening balance,
  /// manual credits, deposit inflow, positive adjustments).
  totalIn  Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of every debit ever posted to this account.
  totalOut Decimal @default(0) @db.Decimal(12, 2)

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("PaymentAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PaymentAccountUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  transactions     PaymentAccountTransaction[]
  depositsDeclared Deposit[]                   @relation("DepositDeclaredAccount")
  depositsReceived Deposit[]                   @relation("DepositReceivingAccount")
  withdrawalsSent  Withdrawal[]                @relation("WithdrawalTransferAccount")
  bankTransactions BankTransaction[]           @relation("BankTransactionAccount")

  @@index([isActive])
  @@index([type])
  @@map("payment_accounts")
}

/// Full audit ledger for a single PaymentAccount — the append-only source of
/// truth backing PaymentAccount.balance/totalIn/totalOut. Rows are never
/// updated or deleted once created; corrections are posted as new rows
/// (ADJUSTMENT_CREDIT/ADJUSTMENT_DEBIT), same convention as
/// Transaction/Wallet.
model PaymentAccountTransaction {
  id                  String                        @id @default(uuid())
  paymentAccountId    String
  type                PaymentAccountTransactionType
  /// Always a positive magnitude — direction is derived from `type`.
  amount              Decimal                       @db.Decimal(12, 2)
  balanceBefore       Decimal                       @db.Decimal(12, 2)
  balanceAfter        Decimal                       @db.Decimal(12, 2)
  /// Free-text transaction/reference code. For DEPOSIT_IN/WITHDRAWAL_OUT
  /// rows this is copied from the deposit/withdrawal's own
  /// receiving/transferTransactionCode at the moment the entry is created;
  /// for manual entries it's whatever the admin types.
  referenceCode       String?
  note                String?
  relatedDepositId    String?
  relatedWithdrawalId String?
  /// Who performed/triggered this movement — the admin for manual entries
  /// and for the approve/link action that generated an automatic
  /// DEPOSIT_IN/WITHDRAWAL_OUT/reversal row.
  performedByUserId   String?
  createdAt           DateTime                      @default(now())

  paymentAccount    PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  relatedDeposit    Deposit?       @relation("DepositLedgerEntries", fields: [relatedDepositId], references: [id], onDelete: SetNull)
  relatedWithdrawal Withdrawal?    @relation("WithdrawalLedgerEntries", fields: [relatedWithdrawalId], references: [id], onDelete: SetNull)
  performedBy       User?          @relation("PaymentAccountTransactionPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentAccountId, createdAt(sort: Desc)])
  @@index([type])
  @@index([createdAt])
  @@index([relatedDepositId])
  @@index([relatedWithdrawalId])
  @@index([performedByUserId])
  @@map("payment_account_transactions")
}

/// The catalog of payment methods (KBZPay, Bank Account, and any Super
/// Admin has added since) offered when creating a PaymentAccount or making
/// a deposit. `label` is the single source of truth for the method's
/// display name and is what gets stored verbatim in PaymentAccount.type —
/// there is no separate internal code, so renaming here is a real rename
/// everywhere. Deleting is blocked while any PaymentAccount still uses it.
model PaymentMethodType {
  id               String   @id @default(uuid())
  label            String   @unique
  requiresBankName Boolean  @default(false)
  /// Logo shown next to this method wherever it's listed (admin, deposit
  /// pickers). Stored the same way as Movie poster/cover URLs — an absolute
  /// MinIO-served URL, not a relative object key.
  logoUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("payment_method_types")
}

/// A monthly subscription tier admins can offer. Plans differ only in
/// name/price — any active subscription, regardless of which plan, unlocks
/// every SUBSCRIPTION-access-type title. Disabling a plan (isActive=false)
/// hides it from new subscribers without affecting anyone already on it.
model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  price        Decimal  @db.Decimal(12, 2)
  /// Length of one purchase in days; renewals stack this onto the current expiry.
  durationDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

/// One subscribe/renew event — append-only, same pattern as Purchase/Deposit.
/// "Is this user currently subscribed" is derived (expiresAt > now()), not
/// stored as a status, so renewing never requires updating an old row.
model UserSubscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  amount    Decimal  @db.Decimal(12, 2)
  startedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_subscriptions")
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model WatchHistory {
  id           String   @id @default(uuid())
  userId       String
  movieId      String
  progress     Float    @default(0) // percent 0-100
  lastPosition Int      @default(0) // seconds
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
  /// Continue-watching list: one user, most recently watched first.
  @@index([userId, updatedAt(sort: Desc)])
  @@map("watch_history")
}

/// Durable, per-user notification feed — persisted so a user sees it even if
/// they were offline when it was created, unlike the real-time socket push
/// that accompanies it. `payload` carries type-specific extra data (e.g. the
/// source depositId) without needing a schema change per notification kind.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  payload   Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Tracking
//
// Everything below is append-only observation of what users actually do —
// what they say (Comment, Feedback), what they look for (SearchQuery), when
// they watch (WatchActivity) and where they connect from (UserSession).
// No existing model changed shape for it; WatchHistory in particular keeps
// its exact "resume where you left off" job and is untouched.
//
// Two rules hold for every model here:
//   - every timestamp is server-side (`new Date()` in the service), never a
//     value the client sent;
//   - `platform` and `ipAddress` come from the per-request context captured
//     in main.ts (see common/storage/request-host.context.ts), never from a
//     body field a caller could forge.
// ---------------------------------------------------------------------------

/// A user's comment on a movie, a series or a book, with at most one level
/// of replies (a reply's own `parentId` is always null — enforced in the
/// service, since the schema cannot express depth).
///
/// EXACTLY ONE of `movieId` / `seriesId` / `bookId` is non-null. Postgres
/// cannot express that as a column constraint through Prisma, so
/// CommentsService validates it on write and every read filters on the one
/// that is set. A reply inherits its parent's target and carries the same one.
model Comment {
  id       String        @id @default(uuid())
  userId   String
  movieId  String?
  seriesId String?
  /// Exactly one of movieId / seriesId / bookId — enforced in CommentsService.
  bookId   String?
  /// Null for a top-level comment; the comment being replied to otherwise.
  parentId String?
  body     String
  status   CommentStatus @default(VISIBLE)

  platform  ClientPlatform @default(UNKNOWN)
  ipAddress String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series  Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  book    Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  /// The public thread: one target's visible top-level comments, newest
  /// first. Each also serves its target's plain lookups and FK cascade.
  @@index([movieId, parentId, status, createdAt])
  @@index([seriesId, parentId, status, createdAt])
  @@index([bookId, parentId, status, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

/// One row per comment an account posted, kept when the comment itself is
/// deleted. CommentsService counts these for its per-account posting limit,
/// so deleting your own comments cannot hand the allowance back (security
/// audit 2026-10-06, M-6). Rows older than the day window are pruned on the
/// account's next post, so the table never holds more than a day per user.
model CommentPostEvent {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("comment_post_events")
}

/// Free-text feedback submitted from the website or the app. Kept forever
/// (an operator's triage history is the point) and never edited by its
/// author — staff only ever move `status` and add an `adminNote`.
model Feedback {
  id       String           @id @default(uuid())
  userId   String
  category FeedbackCategory
  message  String
  status   FeedbackStatus   @default(NEW)

  platform  ClientPlatform @default(UNKNOWN)
  ipAddress String?

  /// Staff member who last moved this out of NEW, and when. Nullable
  /// forever: an untriaged row has neither.
  handledByUserId String?
  handledAt       DateTime?
  /// Internal only — never returned to the feedback's author.
  adminNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting the staff account that triaged a row
  /// must not delete the user's feedback along with it.
  handledBy User? @relation("FeedbackHandledBy", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([handledByUserId])
  @@map("feedback")
}

/// One row per settled search — the log `MoviesService.findAll` never kept.
/// Both clients already debounce (web 300ms, mobile 400ms), so this is one
/// row per keystroke burst, not per keystroke.
///
/// `normalizedTerm` is `term` trimmed, lowercased and with runs of
/// whitespace collapsed to a single space; it is what "top searches" groups
/// by, while `term` keeps the raw spelling so the admin can show the wording
/// users actually typed. `userId` is nullable so an anonymous search is
/// still counted, and survives (SetNull) if the account is later deleted.
model SearchQuery {
  id             String  @id @default(uuid())
  userId         String?
  term           String
  normalizedTerm String
  /// How many results that search actually returned — the signal that
  /// separates "people search for this and find nothing" from "people
  /// search for this a lot".
  resultCount    Int

  platform  ClientPlatform @default(UNKNOWN)
  ipAddress String?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalizedTerm])
  @@index([createdAt])
  @@index([userId])
  @@map("search_queries")
}

/// Hour-bucketed watch activity — the append-safe log WatchHistory can't be.
///
/// WatchHistory holds exactly one upserted row per (user, movie) carrying a
/// position and an `updatedAt`, so it can answer "where did I stop" and
/// nothing else: a re-watch overwrites the previous one and no history of
/// WHEN anybody watched survives. This model keeps that question answerable
/// without touching it — one row per (user, movie, platform, hour), with
/// seconds accumulated by a clamped delta between heartbeats, so a heatmap
/// of when people watch is exact, a backwards seek adds zero rather than a
/// negative, and re-watching adds instead of overwriting.
///
/// `hourStart` is truncated server-side to the top of the hour in UTC;
/// bucketing into local hour-of-day/weekday happens at read time in the
/// tracking service, so the stored value never depends on the server's TZ.
model WatchActivity {
  id         String         @id @default(uuid())
  userId     String
  movieId    String
  platform   ClientPlatform @default(UNKNOWN)
  /// Top of the UTC hour this activity fell in.
  hourStart  DateTime
  /// Accumulated watched seconds in this bucket (clamped per heartbeat).
  seconds    Int            @default(0)
  /// How many heartbeats landed in this bucket — lets a mean-per-heartbeat
  /// sanity check separate real watching from a stuck client.
  heartbeats Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, platform, hourStart])
  @@index([hourStart])
  @@index([movieId])
  @@map("watch_activity")
}

/// One sign-in from one client — created on login and on OTP verify, then
/// touched (at most once per 60s per user) by any authenticated request, so
/// "who is active right now" is answerable without a socket connection.
///
/// `endedAt` is set on an explicit logout; a session that simply goes quiet
/// keeps a null `endedAt` and ages out of the "active" window via
/// `lastSeenAt` instead — there is no reliable client-side end-of-session
/// signal to trust.
model UserSession {
  id        String         @id @default(uuid())
  userId    String
  platform  ClientPlatform @default(UNKNOWN)
  /// Masked server-side unless the caller holds TRACKING.PII_VIEW.
  ipAddress String?
  userAgent String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime
  endedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([lastSeenAt])
  @@index([ipAddress])
  @@map("user_sessions")
}

/// One rung of the deposit-based membership ladder. The user's level is
/// NEVER stored — it is resolved at read time from SUM(APPROVED deposits)
/// against these thresholds (see LevelsService.getUserLevelStatus), so a
/// threshold edit here re-ranks every user by definition.
model UserLevel {
  id        String   @id @default(uuid())
  name      String
  /// Qualifying lifetime deposit total (Ks) required to hold this level.
  threshold Decimal  @db.Decimal(12, 2)
  /// One key from the closed LEVEL_BADGE_ICONS set (levels module) — a glyph
  /// name the frontends draw as inline SVG, never a URL or upload.
  icon      String
  /// #RRGGBB badge tint; light/dark gradient shades are derived client-side.
  color     String
  /// Display position in the ladder and admin list. Resolution math sorts by
  /// threshold, not this — order is presentation only.
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_levels")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// Append-only record of one important staff action. Rows are never updated
/// or deleted by the app.
///
/// Who/what/when is denormalised on purpose: the actor columns are a
/// snapshot taken at write time so the row keeps saying "boss (Admin)" after
/// that account is renamed, re-roled or deleted, and `actor` (SetNull) is
/// only the CURRENT state for the admin to link to when it still exists.
/// Only staff actions land here — AuditService drops anything performed by
/// a `Role.USER` account, so end-user self-service is never recorded —
/// except the two security events forced in on purpose: `user.password_reset`
/// (forgot password) and `user.account_delete` (the owner closed the account).
/// Closing an account is also the one time rows are edited: the person's
/// name is anonymised in them (AuditService.anonymiseUser).
model AuditLog {
  id               String         @id @default(uuid())
  createdAt        DateTime       @default(now())
  category         AuditCategory
  /// Dotted `<target>.<verb>` key, e.g. movie.update, deposit.approve.
  /// Catalogue: src/audit/audit-actions.ts
  action           String
  /// Snapshot of the actor at the time — survives account deletion/rename.
  /// A background job (transcode result, PDF conversion) has no actor: it
  /// stores actorId/actorRole null and actorUsername 'system'.
  actorId          String?
  actorUsername    String
  actorDisplayName String?
  actorRole        Role?
  actorAppRoleId   String?
  actorAppRoleName String?
  /// What was affected. targetType is a snake_case noun from
  /// src/audit/audit-actions.ts (movie, series, book, book_edition, ...).
  targetType       String
  targetId         String?
  targetLabel      String?
  /// [{ field, from, to }] computed from before/after; null for creates,
  /// deletes and pure events.
  changes          Json?
  before           Json?
  after            Json?
  /// Free-form extras: request summary, bulk results, reason, related ids.
  metadata         Json?
  ip               String?
  userAgent        String?
  platform         ClientPlatform @default(UNKNOWN)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([category, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Home showcase (the "Home promos" admin page, 2026-10-08)
// ---------------------------------------------------------------------------

/// Where a home promo appears. HERO = a slide interleaved with the featured
/// titles in the home carousel; SPOTLIGHT = the "New this week" banner (the
/// first live one wins); COMING_SOON = a card in the "Coming soon" strip.
enum HomePromoKind {
  HERO
  SPOTLIGHT
  COMING_SOON
}

/// What a promo's button does. MOVIE / SERIES / BOOK open that title
/// (HomePromo.targetId); URL opens HomePromo.url; NONE shows no button.
enum HomePromoCtaTarget {
  SUBSCRIBE
  ADD_MONEY
  MOVIE
  SERIES
  BOOK
  URL
  NONE
}

/// The drawn artwork a promo uses when it has no uploaded image — each app
/// draws these scenes itself (the showcase design boards' SVG scenes).
enum HomePromoArtPreset {
  PREMIUM
  PAYMENT
  GAMES
  GENERIC
}

/// One staff-managed home promo. Every user-facing text comes as an
/// English + Burmese pair. `targetId` is polymorphic (a movie, series or
/// book id, by ctaTarget), so it has no foreign key: a promo whose title was
/// deleted or unpublished is simply skipped (or, for COMING_SOON, shown
/// without its link) by GET /home/showcase. Live = isActive and now inside
/// [startsAt, endsAt) — either bound may be open.
model HomePromo {
  id          String             @id @default(uuid())
  kind        HomePromoKind
  titleEn     String
  titleMm     String
  kickerEn    String?
  kickerMm    String?
  bodyEn      String?
  bodyMm      String?
  ctaLabelEn  String?
  ctaLabelMm  String?
  ctaTarget   HomePromoCtaTarget @default(NONE)
  targetId    String?
  /// http(s) link, set only when ctaTarget = URL.
  url         String?
  artPreset   HomePromoArtPreset @default(GENERIC)
  /// Absolute URL of one of our own uploads (images/<purpose>/...), stored
  /// canonical and re-hosted per request like every other image URL.
  imageUrl    String?
  /// Short free text for a coming-soon card ("December", "2027"); never a
  /// computed date.
  dateText    String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean            @default(true)
  /// Position within its kind, 0 first.
  sortOrder   Int                @default(0)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User? @relation("HomePromoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// GET /home/showcase reads the active promos of every kind in order.
  @@index([kind, isActive, sortOrder])
  @@index([createdById])
  @@map("home_promos")
}

/// Single global row for the home page's settings, created on the first
/// PUT /home/settings (reads fall back to the defaults below until then).
/// A NULL link means "not set": the card or badge that needs it does not
/// render.
model HomeSettings {
  id                  String   @id @default(uuid())
  webUrl              String?
  appStoreUrl         String?
  playStoreUrl        String?
  gamesTeaserEnabled  Boolean  @default(true)
  gamesTeaserDateText String?
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  updatedBy User? @relation("HomeSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("home_settings")
}

/// The two "dream books" of the Lottery app: one dream for every 3-digit
/// number 000-999 (Dream 1000) and one for every 2-digit number 00-99
/// (Dream 100). On the wire the book is the string "1000" or "100".
enum LotteryDreamBook {
  DREAM_1000
  DREAM_100
}

/// One dream of a dream book (lottery backend phase 1, 2026-10-19). All
/// 1,100 rows exist from the migration on, numbers only; staff fill the
/// names in by editing or by importing a spreadsheet, and upload pictures.
/// A row with no name at all is hidden from customers; a named row with no
/// picture is shown with a placeholder.
model LotteryDream {
  id         String           @id @default(uuid())
  book       LotteryDreamBook
  /// Zero-padded: "027" in the 1000 book, "07" in the 100 book.
  number     String           @db.VarChar(3)
  nameEn     String?
  nameMy     String?
  /// Absolute URL of one of our own uploads (images/lottery/...), stored
  /// canonical and re-hosted per request like every other image URL.
  pictureUrl String?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([book, number])
  @@map("lottery_dreams")
}

/// Where a draw is in its life (lottery backend phase 2, 2026-10-19):
/// SCHEDULED (made, not selling) -> OPEN (selling) <-> PAUSED (selling
/// stopped for a while) -> CLOSED (sales over, by staff or by the minute
/// cron once salesCloseAt passes) -> PUBLISHED (winning numbers in,
/// phase 3). Purchases are only taken while OPEN and before salesCloseAt.
enum LotteryDrawStatus {
  SCHEDULED
  OPEN
  PAUSED
  CLOSED
  PUBLISHED
}

/// WAITING until the draw is published (phase 3), then WON or NOT_WON.
enum LotteryTicketStatus {
  WAITING
  WON
  NOT_WON
}

/// A purchase is paid the moment it exists (one wallet debit in the same
/// transaction); the enum leaves room for a refund state later.
enum LotteryPurchaseStatus {
  PAID
}

/// Where a draw's winning numbers are (lottery backend phase 3,
/// 2026-10-19): PENDING (nothing yet — the source has not published this
/// date, or nobody has entered them) -> FETCHED (a full sheet is in, from
/// the API or by hand, waiting for "Publish and pay winners") ->
/// PUBLISHED (tickets marked, prizes paid, locked). FAILED = the last
/// fetch errored (the five-minute cron retries; the sheet is still empty).
enum LotteryResultStatus {
  PENDING
  FETCHED
  PUBLISHED
  FAILED
}

/// Who supplied the sheet: the configured results source, or a staff
/// member typing the numbers in because the source was down.
enum LotteryResultSource {
  API
  MANUAL
}

/// The life of one awarded prize (since 2026-10-24): UNCLAIMED when the
/// publish awards it (no money moves), REQUESTED once the customer asks for
/// payment (the payout then carries its claimId), PAID when a staff member
/// confirms the claim, REJECTED when they refuse it (reopenable), EXPIRED
/// when the draw's claim deadline passed while it was still UNCLAIMED. The
/// draws published before the change were paid at publish and stay PAID.
enum LotteryPayoutStatus {
  PAID
  UNCLAIMED
  REQUESTED
  REJECTED
  EXPIRED
}

/// One prize claim: REQUESTED by the customer, then PAID or REJECTED by a
/// staff member (REJECTED can go back to REQUESTED with "Review again").
enum LotteryClaimStatus {
  REQUESTED
  PAID
  REJECTED
}

/// Why a claim was rejected — the preset list the admin picks from; OTHER
/// needs a note.
enum LotteryClaimRejectReason {
  SUSPICIOUS_ACCOUNT
  DUPLICATE_REQUEST
  TICKET_UNDER_REVIEW
  OTHER
}

/// The single global row of lottery settings (finance_settings precedent).
/// ticketPrice and maxPerNumber are COPIED into a draw when it is created,
/// so a change here never touches a draw already on sale; exchangeRate
/// (Ks per Baht) is copied at publish time in phase 3;
/// salesCloseMinutesBefore is the default gap between sales close and the
/// Thai draw (14:30 Asia/Bangkok), overridable per draw. resultsUrl is
/// where the winning numbers are fetched from (phase 3); null = fetching
/// off, the sheet is entered by hand.
model LotterySettings {
  id                      String   @id @default(uuid())
  ticketPrice             Decimal  @default(1000) @db.Decimal(12, 2)
  maxPerNumber            Int      @default(20)
  exchangeRate            Decimal  @default(75) @db.Decimal(12, 4)
  salesCloseMinutesBefore Int      @default(60)
  /// The ticket frame every NEW draw is created with (copied into the draw
  /// like ticketPrice). One of our own uploads (images/lottery_frame/...),
  /// stored canonical; null = the app's built-in frame.
  frameUrl                String?
  /// The results source URL (http/https). "{date}" in it is replaced with
  /// the draw date as YYYYMMDD; without it the URL answers the LATEST draw
  /// and the fetched date must match. Null = no fetching, manual entry only.
  resultsUrl              String?
  /// Which parser reads the source's answer; only "thai_lotto_json" exists.
  resultsSourceKind       String   @default("thai_lotto_json")
  /// How many days after publishing a prize may still be requested; copied
  /// into the draw as claimDeadlineAt when it is published. 1..730.
  claimDeadlineDays       Int      @default(90)
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  updatedBy User? @relation("LotterySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("lottery_settings")
}

/// One Thai lottery draw as sold here. `drawNo` is our own running number
/// (ticket numbers carry it: MFL-<drawNo>-<seq>); `thaiDrawDate` is the
/// Thai calendar date, `drawAt` that date at 14:30 Asia/Bangkok in UTC,
/// `salesCloseAt` when selling stops. Price and per-number limit are the
/// settings' values at creation. `nextTicketSeq` is bumped under the draw's
/// row lock by every purchase, so ticket numbers never collide.
model LotteryDraw {
  id                String            @id @default(uuid())
  drawNo            Int               @unique
  thaiDrawDate      DateTime          @db.Date
  drawAt            DateTime
  salesCloseAt      DateTime
  status            LotteryDrawStatus @default(SCHEDULED)
  ticketPrice       Decimal           @db.Decimal(12, 2)
  maxPerNumber      Int
  /// Ks per Baht, copied from the settings when the results are published (phase 3).
  exchangeRate      Decimal?          @db.Decimal(12, 4)
  /// One of our own uploads (images/lottery/...), stored canonical. Locked once a ticket exists.
  pictureUrl        String?
  /// The ticket frame this draw's tickets are drawn on, copied from the
  /// settings at creation (images/lottery_frame/..., canonical; null = the
  /// app's built-in frame). Locked once a ticket exists: a sold ticket keeps
  /// the look it was sold with.
  frameUrl          String?
  nextTicketSeq     Int               @default(1)
  openedAt          DateTime?
  closedAt          DateTime?
  publishedAt       DateTime?
  /// Set by "Publish results" (phase 3) from lottery_payouts: how many
  /// tickets won and, since 2026-10-24, the Ks AWARDED in all
  /// (prizeTotalKs) against the Ks actually PAID so far (prizesPaidKs, 0 at
  /// publish, added to by every confirmed claim). Null until published.
  winnersCount      Int?
  prizesPaidKs      Decimal?          @db.Decimal(12, 2)
  prizeTotalKs      Decimal?          @db.Decimal(12, 2)
  /// Until when a prize of this draw may still be requested (publishedAt +
  /// the settings' claimDeadlineDays, copied like ticketPrice); an UNCLAIMED
  /// payout past it is EXPIRED by the hourly cron. Null until published.
  claimDeadlineAt   DateTime?
  publishedByUserId String?
  createdByUserId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  createdBy      User?                  @relation("LotteryDrawCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedBy    User?                  @relation("LotteryDrawPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  offSaleNumbers LotteryOffSaleNumber[]
  purchases      LotteryPurchase[]
  tickets        LotteryTicket[]
  result         LotteryResult?
  payouts        LotteryPayout[]
  claims         LotteryClaim[]

  /// The "current draw" lookups: by status, nearest draw first.
  @@index([status, drawAt])
  @@index([createdByUserId])
  @@index([publishedByUserId])
  @@map("lottery_draws")
}

/// A 6-digit number staff took off sale for one draw (PUT .../off-sale
/// replaces the whole list). Tickets already sold for it stay valid.
model LotteryOffSaleNumber {
  id        String   @id @default(uuid())
  drawId    String
  number    String   @db.VarChar(6)
  createdAt DateTime @default(now())

  draw LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@unique([drawId, number])
  @@map("lottery_off_sale_numbers")
}

/// One checkout: several numbers with quantities, one wallet debit for the
/// total, one LOTTERY_PURCHASE transaction, one ticket row per ticket.
/// `ref` is what the customer quotes ("LP-261019-0042": Myanmar date +
/// the lottery_purchase_ref_seq sequence). `idempotencyKey` is the app's
/// per-checkout uuid: a replay returns this row and never charges twice.
/// Money rows restrict user deletion like transactions do.
model LotteryPurchase {
  id             String                @id @default(uuid())
  ref            String                @unique
  userId         String
  drawId         String
  idempotencyKey String
  total          Decimal               @db.Decimal(12, 2)
  /// The draw's ticket price at the time, so the lines can be re-priced for display.
  unitPrice      Decimal               @db.Decimal(12, 2)
  status         LotteryPurchaseStatus @default(PAID)
  transactionId  String?               @unique
  createdAt      DateTime              @default(now())

  user        User                  @relation("LotteryPurchaseUser", fields: [userId], references: [id], onDelete: Restrict)
  draw        LotteryDraw           @relation(fields: [drawId], references: [id], onDelete: Restrict)
  transaction Transaction?          @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  lines       LotteryPurchaseLine[]
  tickets     LotteryTicket[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([drawId])
  /// Period scans of Lottery > Analytics (purchases between two instants).
  @@index([createdAt])
  @@map("lottery_purchases")
}

/// One number of a purchase and how many tickets of it were bought.
model LotteryPurchaseLine {
  id         String @id @default(uuid())
  purchaseId String
  number     String @db.VarChar(6)
  quantity   Int

  purchase LotteryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, number])
  @@map("lottery_purchase_lines")
}

/// One ticket (spec rule: one row per ticket, never a quantity). `ticketNo`
/// is "MFL-<drawNo>-<seq padded to 6>", `seq` taken from the draw's
/// nextTicketSeq under its row lock. `status` and `prizeKs` are set when
/// the draw is published (phase 3).
model LotteryTicket {
  id         String              @id @default(uuid())
  ticketNo   String              @unique
  drawId     String
  purchaseId String
  userId     String
  number     String              @db.VarChar(6)
  seq        Int
  status     LotteryTicketStatus @default(WAITING)
  prizeKs    Decimal?            @db.Decimal(12, 2)
  createdAt  DateTime            @default(now())

  draw     LotteryDraw     @relation(fields: [drawId], references: [id], onDelete: Restrict)
  purchase LotteryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  user     User            @relation("LotteryTicketUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Back-relation only: the prize paid for this ticket (phase 3), if it won.
  payout   LotteryPayout?

  @@unique([drawId, seq])
  /// Held-count lookups (how many of one number a draw has sold / a customer holds).
  @@index([drawId, number])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, drawId])
  /// Period scans of Lottery > Analytics (tickets sold between two instants).
  @@index([createdAt])
  @@map("lottery_tickets")
}

/// One draw's winning numbers (lottery backend phase 3, 2026-10-19): one
/// row per draw, made on demand (PENDING, empty sheet) and filled by the
/// five-minute cron / "Fetch now" from the results source, or by a staff
/// member by hand. `groups` is the sheet — nine entries in the fixed order
/// first, nearFirst, second, third, fourth, fifth, front3, back3, back2,
/// each { key, name, baht, count, digits, numbers[] } (prize-groups.ts);
/// `raw` is the source's answer exactly as received, for a later look;
/// `sourceDate` the date the source said it was showing. Once the draw is
/// published the sheet is locked.
model LotteryResult {
  id              String               @id @default(uuid())
  drawId          String               @unique
  status          LotteryResultStatus  @default(PENDING)
  source          LotteryResultSource?
  fetchedAt       DateTime?
  enteredByUserId String?
  raw             Json?
  groups          Json                 @default("[]")
  sourceDate      String?
  lastError       String?
  attempts        Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  draw      LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  enteredBy User?       @relation("LotteryResultEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  @@index([enteredByUserId])
  @@map("lottery_results")
}

/// One prize paid for one winning ticket (phase 3): the groups it won
/// ([{ key, baht, ks }]), the Baht total, the Ks paid (= baht × rate, 2 dp)
/// and the rate used, plus the LOTTERY_PRIZE wallet transaction. One row
/// per ticket (ticketId unique), so a publish that is run again skips the
/// tickets already paid. Money rows never cascade from a user delete.
model LotteryPayout {
  id            String              @id @default(uuid())
  drawId        String
  ticketId      String              @unique
  userId        String
  groups        Json
  baht          Decimal             @db.Decimal(12, 2)
  ks            Decimal             @db.Decimal(12, 2)
  rate          Decimal             @db.Decimal(12, 4)
  /// The LOTTERY_PRIZE row of a prize paid AT PUBLISH (before 2026-10-24,
  /// one per ticket). A prize paid through a claim leaves this null: the
  /// claim's one transaction covers every ticket in it (lottery_claims.
  /// transactionId) and this column is unique per transaction.
  transactionId String?             @unique
  status        LotteryPayoutStatus @default(UNCLAIMED)
  /// The claim this prize was requested under; null while UNCLAIMED or EXPIRED.
  claimId       String?
  createdAt     DateTime            @default(now())

  draw        LotteryDraw   @relation(fields: [drawId], references: [id], onDelete: Restrict)
  ticket      LotteryTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  user        User          @relation("LotteryPayoutUser", fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  claim       LotteryClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([drawId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([claimId])
  /// The admin draw page's claims strip and the summary tiles: counts and Ks per status.
  @@index([drawId, status])
  @@map("lottery_payouts")
}

/// One prize claim (2026-10-24): ONE per customer per draw, bundling every
/// winning ticket they hold in it (the payouts carrying its claimId). The
/// customer creates it REQUESTED from the app; a staff member with
/// LOTTERY.CLAIMS_CONFIRM confirms it (one wallet credit for `ks`, one
/// LOTTERY_PRIZE transaction, payouts PAID) or rejects it with a reason the
/// customer sees (reopenable). `paidAtPublish` marks the claims the
/// migration backfilled for the draws paid at publish before the change.
/// Money rows never cascade from a user delete.
model LotteryClaim {
  id              String                    @id @default(uuid())
  drawId          String
  userId          String
  status          LotteryClaimStatus        @default(REQUESTED)
  ticketsCount    Int
  baht            Decimal                   @db.Decimal(12, 2)
  ks              Decimal                   @db.Decimal(12, 2)
  /// Ks per Baht the figures use — the draw's exchangeRate at request time.
  rate            Decimal                   @db.Decimal(12, 4)
  requestedAt     DateTime
  /// When it was confirmed or rejected, and by whom; cleared by "Review again".
  decidedAt       DateTime?
  decidedByUserId String?
  rejectReason    LotteryClaimRejectReason?
  rejectNote      String?                   @db.VarChar(300)
  /// The one LOTTERY_PRIZE row a confirm wrote; null for a backfilled claim
  /// (its payouts carry their own) and for a 0 Ks claim.
  transactionId   String?                   @unique
  paidAtPublish   Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  draw        LotteryDraw     @relation(fields: [drawId], references: [id], onDelete: Restrict)
  user        User            @relation("LotteryClaimUser", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy   User?           @relation("LotteryClaimDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  transaction Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  payouts     LotteryPayout[]

  @@unique([drawId, userId])
  /// The admin "Prize claims" page: the waiting list oldest first, the paid / rejected tabs.
  @@index([status, requestedAt])
  /// The customer's own claims, newest first.
  @@index([userId, requestedAt(sort: Desc)])
  @@index([decidedByUserId])
  @@map("lottery_claims")
}

/// Lottery presence (2026-10-23): one row per signed-in user per client
/// platform per MYANMAR hour while they are inside the Lottery — the app
/// pings POST /lottery/activity (LotteryActivityService, one write per user
/// per minute). Feeds the "active users" series of Lottery > Analytics;
/// guests never ping, so they are not counted. Not draw-scoped: a ping has
/// no draw.
model LotteryActivity {
  id        String         @id @default(uuid())
  userId    String
  platform  ClientPlatform @default(UNKNOWN)
  /// Start of the MYANMAR hour (UTC+6:30) the ping fell in, stored as the
  /// UTC instant — so :30 past the UTC hour (13:30 UTC = 20:00 MMT). Unlike
  /// WatchActivity.hourStart (UTC top of the hour): the analytics bucket
  /// everything in Myanmar time, and this way `hourStart + 390 min` is an
  /// exact MMT hour, in step with the tickets and purchases beside it.
  hourStart DateTime
  /// How many pings landed in this bucket.
  pings     Int            @default(1)
  firstAt   DateTime
  lastAt    DateTime

  user User @relation("LotteryActivityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, hourStart])
  /// Period scans and "when did tracking start".
  @@index([hourStart])
  @@index([userId])
  @@map("lottery_activity")
}

/// Which titles a pre-roll ad plays before: every movie (episodes included),
/// or only the rows in advertisement_movies.
enum AdvertisementTargetType {
  ALL
  SELECTED
}

/// What kind of ad a row is (2026-11-04): a VIDEO ad plays before the
/// movie and/or at the mid-roll breaks; a CORNER ad is a small picture shown
/// in the top-right corner while the movie plays. Fixed at creation.
enum AdvertisementFormat {
  VIDEO
  CORNER
}

/// Where one decided play happened (advertisement_playbacks.placement):
/// before the movie, at a mid-roll break, or as the corner picture.
enum AdvertisementPlacement {
  PREROLL
  MIDROLL
  CORNER
}

/// Who gets the in-movie ads (mid-roll breaks + corner pictures):
/// everyone, or only viewers without an active subscription. The ad before
/// the movie plays for everyone either way.
enum AdvertisementAudience {
  ALL
  NON_PREMIUM
}

/// One decided pre-roll play (advertisement_playbacks). PENDING = decided,
/// the player has not reported a first frame yet; STARTED = first frame (the
/// one impression); COMPLETED / SKIPPED end a STARTED play; FAILED = the
/// player could not load or finish it (before or after the first frame);
/// ABANDONED = a PENDING row superseded by a newer decision for the same
/// viewer and title. Order matters for nothing.
enum AdvertisementPlaybackStatus {
  PENDING
  STARTED
  COMPLETED
  SKIPPED
  FAILED
  ABANDONED
}

/// A pre-roll video advertisement (admin "Advertisements" page, 2026-11-04):
/// a short MP4 that plays inside the player before a movie starts. The
/// backend picks one per play (POST /ads/preroll) from the active rows
/// whose schedule, daily window and target fit; the player reports
/// started / completed / skipped / failed into advertisement_playbacks.
model Advertisement {
  id                          String                  @id @default(uuid())
  title                       String
  description                 String?
  /// Canonical MinIO key `ads/<id>/v-<tag>/video.mp4`, never an absolute
  /// URL (the signed playback URL is minted per request). Null until
  /// POST /ads/admin/:id/video/attach lands a file; an ad without a video
  /// cannot be switched on.
  videoKey                    String?
  videoBytes                  Int?
  videoEtag                   String?
  /// Whole seconds from ffprobe at attach time; the player's countdown and
  /// the skipAfterSeconds rule key on it.
  durationSeconds             Int?
  videoAttachedAt             DateTime?
  isActive                    Boolean                 @default(true)
  startsAt                    DateTime?
  endsAt                      DateTime?
  /// Daily window as minutes after midnight (0..1439) read in
  /// tzOffsetMinutes; both null = all day; start > end wraps past midnight.
  dailyStartMinutes           Int?
  dailyEndMinutes             Int?
  /// Fixed UTC offset the daily window is read in. 390 = Myanmar (no DST).
  tzOffsetMinutes             Int                     @default(390)
  targetType                  AdvertisementTargetType @default(ALL)
  /// Higher plays first when several ads qualify.
  priority                    Int                     @default(0)
  isSkippable                 Boolean                 @default(false)
  /// Required when isSkippable, null otherwise; must be < durationSeconds.
  skipAfterSeconds            Int?
  /// Minimum minutes between two impressions of THIS ad for one viewer; null = none.
  frequencyLimitMinutes       Int?
  /// Impressions of this ad one viewer may get per Myanmar day; null = unlimited.
  maxImpressionsPerUserPerDay Int?
  /// VIDEO (an MP4 before the movie / at breaks) or CORNER (a picture in the
  /// corner while the movie plays). Fixed at creation.
  format                      AdvertisementFormat     @default(VIDEO)
  /// VIDEO only: plays before the movie (every ad made before breaks existed).
  playsBeforeMovie            Boolean                 @default(true)
  /// VIDEO only: plays at the mid-roll breaks.
  playsAtBreaks               Boolean                 @default(false)
  /// CORNER only: canonical MinIO key `images/ad/<id>/<tag><ext>` (public;
  /// the URL is built per request). Null until POST /ads/admin/:id/image.
  imageKey                    String?
  imageBytes                  Int?
  imageWidth                  Int?
  imageHeight                 Int?
  imageAttachedAt             DateTime?
  /// CORNER only: an http(s) page a tap opens; null = picture only.
  linkUrl                     String?
  /// CORNER only: seconds visible per showing; null = until the viewer closes it.
  cornerShowSeconds           Int?
  /// CORNER only: minutes WATCHED after it leaves before it comes back; null = once.
  cornerRepeatMinutes         Int?
  /// CORNER only: the viewer may close it (always true for "until closed").
  cornerClosable              Boolean                 @default(true)
  createdById                 String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  createdBy User?                   @relation("AdvertisementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  movies    AdvertisementMovie[]
  playbacks AdvertisementPlayback[]

  /// The preroll decision: the active rows, best priority first.
  @@index([isActive, priority(sort: Desc)])
  @@index([createdById])
  @@map("advertisements")
}

/// One selected title of a SELECTED ad. The list is replaced whole on every
/// save (like a draw's off-sale numbers), so no row is ever edited in place.
model AdvertisementMovie {
  id              String   @id @default(uuid())
  advertisementId String
  movieId         String
  createdAt       DateTime @default(now())

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  movie         Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([advertisementId, movieId])
  @@index([movieId])
  @@map("advertisement_movies")
}

/// One decided pre-roll play: created PENDING by POST /ads/preroll, moved
/// forward by the player's events (POST /ads/playbacks/:id/events). The row
/// IS the impression id; `startedAt` not null = one impression, whatever
/// happened after. Timestamps are always the server's.
model AdvertisementPlayback {
  id              String                      @id @default(uuid())
  advertisementId String
  userId          String
  movieId         String
  /// From the X-Client-Platform header at decision time, never the body.
  platform        ClientPlatform              @default(UNKNOWN)
  status          AdvertisementPlaybackStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  skippedAt       DateTime?
  failedAt        DateTime?
  /// Player position (seconds) when skipped / failed.
  positionSeconds Int?
  /// Before the movie, at a break, or the corner picture (2026-11-04).
  placement       AdvertisementPlacement      @default(PREROLL)
  /// MIDROLL only: the movie second the break sits at (k × interval) —
  /// a position, so an interval change never renames a played break.
  breakAtSeconds  Int?
  /// CORNER only: how many times it came back after the first showing.
  repeatCount     Int                         @default(0)
  /// CORNER only: taps on its link.
  clickCount      Int                         @default(0)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  user          User          @relation("AdvertisementPlaybackUser", fields: [userId], references: [id], onDelete: Cascade)
  movie         Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)

  /// Frequency / daily caps: one viewer's impressions of one ad.
  @@index([userId, advertisementId, startedAt])
  /// Analytics: per ad and by date, both on the impression instant.
  @@index([advertisementId, startedAt])
  @@index([startedAt])
  @@index([movieId])
  /// One viewer's recent rows for one title: the replay rule, the open
  /// decisions handed back on a refresh, and the breaks already played.
  @@index([userId, movieId, createdAt])
  /// The analytics' "failed to load" figure (failed before a first frame).
  @@index([failedAt], map: "advertisement_playbacks_load_failed_idx", where: raw("\"startedAt\" IS NULL AND \"status\" = 'FAILED'"))
  @@map("advertisement_playbacks")
}

/// The admin "Advertisements" page's playback rules (2026-11-04): one global
/// row, created on the first PUT /ads/admin/settings (reads fall back to the
/// defaults below until then).
model AdSettings {
  id                     String                @id @default(uuid())
  /// Master switch: false = no ads of any kind anywhere (2026-11-04).
  adsEnabled             Boolean               @default(true)
  /// Mid-roll breaks every this many minutes of MOVIE position; 0 = off.
  midrollIntervalMinutes Int                   @default(0)
  /// Who gets the breaks and the corner pictures.
  duringMovieAudience    AdvertisementAudience @default(ALL)
  updatedByUserId        String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  updatedBy User? @relation("AdSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("ad_settings")
}
