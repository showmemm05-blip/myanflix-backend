DATABASE_URL=postgresql://user:password@localhost:5432/myanflix?schema=public

NODE_ENV=development
PORT=3001

JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_PATH=./storage

# Storage server (MinIO) — see ../storage-server. Credentials here must match
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD in storage-server/.env.
MINIO_ENDPOINT=http://localhost:9000
# Only used to sign presigned URLs handed to the admin browser for direct
# uploads (see MultipartUploadService) — must be reachable from the browser,
# unlike MINIO_ENDPOINT which can be an internal/Docker-only address. Points
# at ../storage-server/upload-proxy locally so dev exercises the same
# browser->proxy->MinIO path prod uses. In prod this becomes the proxy's
# public HTTPS URL, never MinIO's raw port exposed directly. Falls back to
# MINIO_ENDPOINT if unset.
MINIO_PUBLIC_ENDPOINT=http://localhost:8443
MINIO_ACCESS_KEY=myanflix
MINIO_SECRET_KEY=change-me-locally
MINIO_BUCKET=movies

# CORS for direct browser->MinIO uploads is configured on MinIO itself, not
# here — see MINIO_API_CORS_ALLOW_ORIGIN in ../storage-server/.env.example.
# (The AWS SDK's PutBucketCorsCommand doesn't work against MinIO — see
# MinioService.ensureLifecycle()'s doc comment for the full story.)

# Cache server — see ../cacheserver. This is what end users' browsers
# actually fetch video bytes from, never this backend or MinIO directly.
STREAM_PUBLIC_BASE_URL=http://localhost:8080

# API rate limiting (see src/common/throttling/throttling.config.ts): 300
# requests/min per IP per route everywhere, plus tight per-phone/per-IP
# buckets on the auth routes. "true" switches it off entirely — only the
# jest/e2e environment does that; leave unset (or "false") in production.
THROTTLE_DISABLED=false
# Comma-separated IPs of reverse proxies in front of the API (e.g. an nginx container).
# Only their X-Forwarded-For is trusted for per-IP rate limits. Leave empty when the API is reached directly.
TRUSTED_PROXIES=

# "Continue with Google" — OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID, type Web application).
# Must be the SAME value the website bakes in as NEXT_PUBLIC_GOOGLE_CLIENT_ID:
# the backend verifies every Google ID token's audience against it. Empty =
# feature disabled (POST /auth/google answers 503); phone login is unaffected.
GOOGLE_CLIENT_ID=
# Client secret of that SAME OAuth Web client (shown once in Cloud Console
# when the client is created; "Reset secret" issues a new one). Needed only
# by the popup auth-code flow (POST /auth/google with `code`), which the
# backend exchanges with Google server-side — it never reaches the website
# bundle. Empty = the code path answers 503 while the ID-token (`credential`)
# path keeps working. Never commit a real value.
GOOGLE_CLIENT_SECRET=

# --- Only used by docker-compose.yml (backend/docker-compose.yml), not by
# plain `npm run start:dev` — it constructs DATABASE_URL itself from these.
POSTGRES_USER=myanflix
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=myanflix
POSTGRES_PORT=5432
