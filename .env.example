# Every setting the APP reads must ALSO be listed in docker-compose.yml's
# backend `environment:` block — the image carries no .env, so a value typed
# here never reaches the container otherwise (eight were missing until
# 2026-10-09). src/config/docker-compose-env.spec.ts fails when one is
# missing. The "# --- Only ..." sections near the end are the exception:
# compose itself and the scripts read those, the app never does.

DATABASE_URL=postgresql://user:password@localhost:5432/myanflix?schema=public
# Optional. Most database connections this backend keeps open at once.
# Empty = 10 (node-postgres' default, the behaviour before this setting
# existed). Whole number 1-50. Keep the total across every process that uses
# the database well under Postgres' max_connections (100 by default). A
# query that waits 10 s for a free connection fails instead of hanging.
DATABASE_POOL_MAX=

NODE_ENV=development
PORT=3001

# Two DIFFERENT random secrets, 32+ characters each (`openssl rand -hex 32`
# twice). Whoever knows one can mint a token for any account, so there is no
# placeholder here on purpose: the backend refuses to boot with an empty or
# placeholder-looking value, and with NODE_ENV=production also when either is
# under 32 characters or the two are equal.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local scratch root. Nothing durable lives here — everything durable is an
# object in MinIO. Every transient file sits under <STORAGE_PATH>/temp/
# (temp/uploads/<uploadId>/chunk_<n>, temp/videos/<movieId>/hls/...,
# temp/documents/books/<b>/<e>/<c>/<runId>/), which is the one directory the
# cleanup sweep walks — see ../docs/media-storage-layout.md. Relative paths
# resolve against the process cwd.
STORAGE_PATH=./storage

# Storage server (MinIO) — see ../storage-server. Credentials here must match
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD in storage-server/.env.
MINIO_ENDPOINT=http://localhost:9000
# Only used to sign presigned URLs handed to the admin browser for direct
# uploads (see MultipartUploadService) — must be reachable from the browser,
# unlike MINIO_ENDPOINT which can be an internal/Docker-only address. Points
# at ../storage-server/upload-proxy locally so dev exercises the same
# browser->proxy->MinIO path prod uses. In prod this becomes the proxy's
# public HTTPS URL, never MinIO's raw port exposed directly. Falls back to
# MINIO_ENDPOINT if unset. With NODE_ENV=production and a public
# STREAM_PUBLIC_BASE_URL the backend refuses to start while this is unset or
# localhost/127.0.0.1/host.docker.internal (no staff browser can reach those).
MINIO_PUBLIC_ENDPOINT=http://localhost:8443
MINIO_ACCESS_KEY=myanflix
MINIO_SECRET_KEY=change-me-locally
MINIO_BUCKET=movies

# CORS for direct browser->MinIO uploads is configured on MinIO itself, not
# here — see MINIO_API_CORS_ALLOW_ORIGIN in ../storage-server/.env.example.
# (The AWS SDK's PutBucketCorsCommand doesn't work against MinIO — see
# MinioService.ensureLifecycle()'s doc comment for the full story.)

# Cache server — see ../cacheserver. This is what end users' browsers
# actually fetch video bytes from, never this backend or MinIO directly.
# Production: the cache server's own public address, e.g.
# https://cache.example.com (see DOCKER.md, "Moving to the real VPS").
STREAM_PUBLIC_BASE_URL=http://localhost:8080
# Is STREAM_PUBLIC_BASE_URL the cache server's own address? "true" or
# "false"; empty = "false".
#   false: every playback and image URL keeps only the protocol and port of
#          the base above and takes its HOST from the request (the host the
#          app used to reach the API). Right for a dev machine that hops
#          networks — the cache runs on that same machine.
#   true:  the base above is used exactly as written. Needed whenever the
#          cache server has an address of its own (a separate VPS, a CDN):
#          there the API host is the one machine with no cache on it, so
#          "false" would point every stream and poster at the wrong server.
# With NODE_ENV=production the backend refuses to start while this is empty
# and STREAM_PUBLIC_BASE_URL is a public address (not localhost, 127.x,
# 10.x, 172.16-31.x, 192.168.x or *.local). Set it to "true" on the
# three-VPS layout.
STREAM_PUBLIC_BASE_URL_IS_PUBLIC=
# Optional. Where the BACKEND PROCESS itself reaches the cache server for
# server-side checks (the admin's "Check playback" diagnosis fetches the
# signed master playlist through it). Never used to build a URL a client
# receives. Inside Docker the request-derived host is the container itself,
# so docker-compose defaults this to http://host.docker.internal:8080; a
# native `npm run start:dev` can leave it unset. On the three-VPS layout set
# it to the cache server's address (the same https URL as
# STREAM_PUBLIC_BASE_URL works), or the admin's "Check playback" reports a
# false connection error.
# STREAM_INTERNAL_BASE_URL=http://localhost:8080

# Signs the /s/<expires>/<signature>/ token carried in the path of every
# playback link; the cache server's nginx refuses any stream request whose
# token does not verify. Generate with `openssl rand -hex 32` and put the
# SAME value in ../cacheserver/.env — the two must match or nothing plays.
# Required (32+ characters): the backend refuses to boot while this is
# empty — deliberately no placeholder, so a copied-but-unedited file cannot
# end up signing every link with a secret everyone knows.
STREAM_SIGNING_SECRET=
# How long one playback link stays valid, in seconds. Default 4 h (14400).
# A link is a bearer URL: anyone holding it can play that title until it
# expires, so the shorter it lives the less a pasted link is worth; the
# players fetch a fresh link on 410. The expiry is rounded to the hour, so
# the real lifetime is TTL-1h .. TTL — minimum 3600 (a shorter TTL would
# mint already-expired links).
STREAM_URL_TTL_SECONDS=14400

# API rate limiting (see src/common/throttling/throttling.config.ts): 300
# requests/min per IP per route everywhere, plus tight per-phone/per-IP
# buckets on the auth routes. "true" switches it off entirely — only the
# jest/e2e environment does that; leave unset (or "false") in production.
THROTTLE_DISABLED=false
# Comma-separated IPs of the reverse proxies in front of the API (e.g. the
# nginx/HTTPS container). Only a connection FROM one of them may set
# X-Forwarded-For — for the per-IP rate limits, every tracking row (comments,
# sessions, last seen, audit) and the live "active users" list alike; from
# anyone else the header is ignored. Leave empty while the API is reached
# directly. REQUIRED the day a proxy goes in front: left empty, every visitor
# then arrives from the proxy's address and shares ONE rate-limit bucket (50
# OTP requests lock everyone out of sign-in for an hour). A production boot
# with a public STREAM_PUBLIC_BASE_URL and an empty list logs a warning. The
# proxy must REPLACE the header with the real client address ($remote_addr),
# not append to what the client sent. See DOCKER.md.
TRUSTED_PROXIES=
# Browser origins allowed to call the API cross-origin, comma-separated, e.g.
# https://admin.example.com,https://www.example.com (scheme, host, optional
# port — nothing after). Empty = any origin, exactly as before. Requests with
# no Origin header (the mobile app, the phone-monitor, curl) are never
# affected. Set it on the real deployment to the admin and website origins;
# a browser page on any other site then cannot call the API. The same list
# applies to the socket.io handshake.
CORS_ORIGINS=

# "Continue with Google" — OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID, type Web application).
# Must be the SAME value the website bakes in as NEXT_PUBLIC_GOOGLE_CLIENT_ID:
# the backend verifies every Google ID token's audience against it. Empty =
# feature disabled (POST /auth/google answers 503); phone login is unaffected.
GOOGLE_CLIENT_ID=
# Client secret of that SAME OAuth Web client (shown once in Cloud Console
# when the client is created; "Reset secret" issues a new one). Needed only
# by the popup auth-code flow (POST /auth/google with `code`), which the
# backend exchanges with Google server-side — it never reaches the website
# bundle. Empty = the code path answers 503 while the ID-token (`credential`)
# path keeps working. Never commit a real value.
GOOGLE_CLIENT_SECRET=

# Shared secret the phone-monitor desktop app presents (Authorization: Bearer)
# on POST /bank-events/* and on its socket handshake. Generate with
# `openssl rand -hex 32` and put the SAME value in the phone-monitor's
# config.json (myanflix.token). Empty = bank-event ingestion disabled: those
# routes answer 503 and the socket refuses machine handshakes. Never a user
# login, never a JWT, never committed. Rotating it: change this, restart the
# backend, edit the phone-monitor's config.json.
BANK_EVENTS_TOKEN=

# How OTP codes are sent (see src/sms/sms.config.ts):
#   log           — the default. NOTHING is sent; development only. The
#                   backend prints a loud warning at startup and never logs
#                   the code (read development codes from otp_codes).
#   phone-gateway — the company Android phone (sms-gateway-android) sends
#                   every code as a normal SMS from its own SIM. No external
#                   SMS provider, no Firebase, no FCM.
# Empty/unset = log, so a missing provider never stops the backend booting.
SMS_PROVIDER=log
# Shared secret the gateway phone presents (Authorization: Bearer) on every
# /api/sms-gateway/device/* route. Generate with `openssl rand -hex 32` and
# type the SAME value into the gateway app's settings. Required (32+
# characters) when SMS_PROVIDER=phone-gateway — the backend refuses to boot
# without it then. Empty = every device route answers 401. Never a user
# login, never a JWT, never committed. Rotating it: change this, restart the
# backend, re-enter it on the phone.
# The token is bound to ONE phone: the first device id that presents it is
# pinned (sms_gateway_binding), every other device gets 401, and the admin
# dashboard's SMS card shows the pinned device and warns when another
# device tried the token. After reinstalling the app or changing phones, a
# super admin presses "Reset phone" on that card (DELETE /api/sms-gateway/
# binding) and the next phone to present the token is pinned. If the card's
# warning comes back right after a reset, someone else took the pin first:
# rotate this token, then reset again. Someone holding BOTH this token and
# the phone's device id can still pose as the phone (audit M-28, open) —
# see DOCKER.md, "SMS gateway phone".
SMS_GATEWAY_TOKEN=
# At most this many SMS are queued per UTC day; beyond it code requests get
# 503 "SMS service is temporarily unavailable". Protects the SIM's plan and
# the carrier's anti-spam limits. The last-resort brake. Default 1000.
SMS_DAILY_CAP=1000
# At most this many SMS go to ONE phone number per UTC day; beyond it that
# number gets 409 "Too many code requests — please try again later" (SMS a
# resend cancelled, or that expired before the phone took them, do not
# count). Stops anyone flooding a number from the company SIM. Default 10.
SMS_DAILY_CAP_PER_PHONE=10
# The gateway counts as offline (code requests get the same 503, and the
# code is not kept) once no heartbeat or job poll has arrived from the phone
# for this many seconds. The phone heartbeats every 30 s. Default 90,
# minimum 30.
SMS_GATEWAY_OFFLINE_AFTER_SECONDS=90

# Server secret mixed into every 6-digit withdrawal code before it is hashed,
# so a leaked database alone cannot be brute-forced back into codes. At least
# 32 characters (`openssl rand -hex 32`). Required when NODE_ENV=production
# and STREAM_PUBLIC_BASE_URL is a public address; optional on a LAN setup.
# NEVER change or remove it once set: every saved code stops working
# (users then answer 503 until they use "Forgot code?").
WITHDRAWAL_CODE_PEPPER=

# Server secret that keys the hash every SMS one-time code (sign-in,
# password reset, withdrawal-code reset) is stored under, so a leaked
# database alone cannot be read for live codes (M-1). At least 32
# characters (`openssl rand -hex 32`). Required when NODE_ENV=production
# and STREAM_PUBLIC_BASE_URL is a public address; when unset the backend
# derives a key from JWT_SECRET instead and logs a warning in production.
# Safe to change later: only codes still in flight (5 minutes) stop working.
OTP_CODE_PEPPER=

# LOCAL DEVELOPMENT ONLY — NEVER IN PRODUCTION. A fixed 6-digit code that
# EVERY one-time code becomes (sign-in, password reset, withdrawal-code
# reset), so you can sign in and out without a real SMS. While it is set NO
# SMS is sent or queued for the gateway phone; the code is still stored only
# as a hash and still expires after 5 minutes, works once, allows 5 tries,
# and the 60-second resend wait and 8-codes-per-hour limit still apply. The
# backend logs "OTP_DEV_CODE is ON ..." at startup, and REFUSES TO START
# with it set, whatever NODE_ENV says, on anything that looks like a real
# server: STREAM_PUBLIC_BASE_URL public (or not an http(s) URL),
# STREAM_PUBLIC_BASE_URL_IS_PUBLIC=true, MINIO_PUBLIC_ENDPOINT or any
# CORS_ORIGINS entry not localhost/LAN, or TRUSTED_PROXIES set. Exactly 6
# digits; empty/unset = off (real codes). Remove the line when you are done.
# OTP_DEV_CODE=123456

# --- Only used by docker-compose.yml (backend/docker-compose.yml), not by
# plain `npm run start:dev` — it constructs DATABASE_URL itself from these.
POSTGRES_USER=myanflix
# Required — compose refuses to start while it is empty (no fallback).
POSTGRES_PASSWORD=
POSTGRES_DB=myanflix
POSTGRES_PORT=5432

# --- Only read by the seed scripts (npm run db:seed / db:seed:users), never
# by the app. Local demo data only. Every seeded account gets SEED_PASSWORD
# (8+ characters, no default — the seeds refuse to run without it). The seeds
# also refuse NODE_ENV=production unless ALLOW_SEED_IN_PRODUCTION=true is set
# for that one run; db:seed WIPES users, titles and money tables.
SEED_PASSWORD=
# ALLOW_SEED_IN_PRODUCTION=

# --- Only read by `npm run create-superadmin` (one time, fresh database; see
# DOCKER.md). SUPERADMIN_USERNAME may replace --username. SUPERADMIN_PASSWORD
# is a ONE-TIME value for that single command: pass it on the command line
# environment (or type it at the prompt) and never keep it in this file.
# SUPERADMIN_USERNAME=
# SUPERADMIN_PASSWORD=

# --- Only read by `npm run test:e2e` (test/e2e-setup.ts), never by the app.
# The e2e specs write real rows, so they need their OWN database: the name
# must end in "_test" (e.g. myanflix_test, built with `prisma migrate deploy`)
# or the run refuses to start. Export it in the shell for the run rather than
# leaving it here; nothing in the repo supplies a default.
E2E_DATABASE_URL=

# --- Only read by scripts/db-backup.sh (npm run db:backup), never by the app.
# Where every dump is copied once it is made and checked: a folder on another
# disk, or user@host:/folder over SSH (key login; create the folder first).
# Empty = dumps stay only in ./backups on this machine, and a disk failure
# takes them with it. See DOCKER.md, "Backups".
BACKUP_OFFSITE_DEST=
# Where dumps are written (default ./backups, git- and Docker-ignored, every
# file mode 0600). Set it to a folder outside the repo to keep dumps away
# from the source tree entirely; the restore scripts read the same setting.
# BACKUP_DIR=

# Staff upload budgets (see src/uploads/upload-limits.ts). Generous ceilings
# that stop one staff login from filling a disk; raise them here if a real
# file ever needs more. Bytes, whole numbers. Defaults when unset:
#   UPLOAD_MAX_VIDEO_BYTES     64424509440  (60 GB — a movie original / bundle file)
#   UPLOAD_MAX_DOCUMENT_BYTES  524288000    (500 MB — a book chapter PDF)
#   UPLOAD_MIN_FREE_DISK_BYTES 2147483648   (2 GB that STORAGE_PATH's disk must always
#                                            keep free: a chunked session needs
#                                            2 x its filesize + this at init (chunks
#                                            and the merged copy are on disk together),
#                                            and every chunk write and the merge are
#                                            refused with 507 rather than eat into it)
#   UPLOAD_MAX_OPEN_SESSIONS_PER_MOVIE 32    (chunked sessions one movie may have open
#                                            at once; the admin uses 4, abandoned ones
#                                            stop counting after 48 h; 409 beyond it)
UPLOAD_MAX_VIDEO_BYTES=
UPLOAD_MAX_DOCUMENT_BYTES=
UPLOAD_MIN_FREE_DISK_BYTES=
UPLOAD_MAX_OPEN_SESSIONS_PER_MOVIE=

# Processing bounds (see src/books/book-processing.service.ts and
# src/processing/ffmpeg.util.ts). pdfinfo / pdftoppm / ffprobe / ffmpeg are
# always killed when they run past their budget; these two are the knobs.
#   BOOK_CONVERSION_CONCURRENCY      how many chapter PDFs convert at once across
#                                    the whole process (extra starts queue). Default 2.
#   FFMPEG_RENDITION_TIMEOUT_MINUTES longest ONE HLS rendition may transcode before
#                                    ffmpeg is stopped and the video fails. Default 360.
BOOK_CONVERSION_CONCURRENCY=
FFMPEG_RENDITION_TIMEOUT_MINUTES=
# How many videos transcode at the same time across the whole process (extra
# videos wait their turn in "Processing"). Whole number 1-8. Default 1:
# every transcode already runs ffmpeg on all CPU cores it is given.
VIDEO_TRANSCODE_CONCURRENCY=
